      function toast(msg, erro) {
        const el = $('#toast');
        if (!el) return;
        el.textContent = msg;
        el.className = 'toast show' + (erro ? ' error' : '');
        clearTimeout(toast.timer);
        toast.timer = setTimeout(() => el.className = 'toast', 4000);
      }

      function loading(on) {
        const el = $('#loadingPill');
        if (el) el.classList.toggle('show', !!on);
      }

      function server(fn, ...args) {
        return new Promise((resolve, reject) => {
          if (typeof google === 'undefined' || !google.script || !google.script.run) {
            reject(new Error('Ambiente Google Apps Script não detectado.'));
            return;
          }
          const timer = setTimeout(() => {
            reject(new Error('Tempo esgotado ao chamar ' + fn + '. Verifique se o Apps Script salvo/publicado é o arquivo correto e rode fausDiagnosticoFinanceiro no editor.'));
          }, 45000);
          google.script.run
            .withSuccessHandler(res => {
              clearTimeout(timer);
              resolve(res);
            })
            .withFailureHandler(e => {
              clearTimeout(timer);
              reject(new Error(e && e.message ? e.message : String(e)));
            })
            [fn](...args);
        });
      }

      function formData(form) {
        const obj = {};
        new FormData(form).forEach((v, k) => obj[k] = String(v).trim());
        return obj;
      }

      
      
      

      async function carregar(msg, tentativa, opcoes) {
        tentativa = tentativa || 0;
        opcoes = opcoes || {};
        if (opcoes.force && state.view === 'afazeres') return atualizarAfazeres(msg);
        if (typeof google === 'undefined' || !google.script || !google.script.run) {
          if (tentativa < 20) {
            setTimeout(() => carregar(msg, tentativa + 1, opcoes), 150);
            return;
          }
          if (CRM_DEMO_ATIVO) {
            state.data = state.data || crmPayloadLocal();
            state.crmModoDemo = true;
            state.crmErro = '';
            state.crmCarregando = false;
            render();
            toast('Modo local: CRM usando dados fictícios de demonstração.');
            return;
          }
          toast('Não foi possível conectar ao Apps Script.', true);
          return;
        }

        loading(true);
        try {
          const forcarAtualizacao = !!opcoes.force;
          const revisaoAfazeres = state.afazeresRevisao;
          // O bootstrap pode vir do cache; Afazeres usa a leitura direta existente.
          const [dados, afazeres] = await Promise.all([
            server(forcarAtualizacao ? 'fausBootstrapAtualizado' : 'fausBootstrap'),
            server('fausCarregarAfazeresAtualizados').catch(e => {
              toast('Erro ao atualizar afazeres: ' + e.message, true);
              return state.data || { tarefas: [], projetos: [] };
            })
          ]);
          if (!afazeres || !Array.isArray(afazeres.tarefas) || !Array.isArray(afazeres.projetos)) {
            throw new Error('Resposta de afazeres inválida.');
          }
          dados.tarefas = afazeres.tarefas;
          dados.projetos = afazeres.projetos;
          if (state.data && (state.afazeresRevisao !== revisaoAfazeres || haAfazeresPendentes())) {
            dados.tarefas = state.data.tarefas;
            dados.projetos = state.data.projetos;
          }
          state.data = dados;
          if (forcarAtualizacao) {
            state.crmReal = null;
            state.crmErro = '';
            state.financeiroCompleto = false;
          }
          render();
          if (forcarAtualizacao && state.view === 'crm') {
            await carregarCRMSePreciso(true);
          }
          if (forcarAtualizacao && state.view === 'financeiro') {
            await carregarFinanceiroCompletoSePreciso(true);
          }
          if (msg) toast(msg);
          if (state.data.meta && state.data.meta.dashboardCacheErro) {
            toast(state.data.meta.dashboardCacheErro, true);
          }
          if (state.data.meta && state.data.meta.financeiroErro) {
            toast('Financeiro alternativo: ' + state.data.meta.financeiroErro, true);
          }
          if (state.data.meta && state.data.meta.bootstrapErro) {
            toast('Painel carregou com avisos: ' + state.data.meta.bootstrapErro, true);
          }
        } catch (e) {
          toast('Erro ao sincronizar: ' + e.message, true);
        } finally {
          loading(false);
        }
      }

      function carregarAtualizado(msg) {
        return carregar(msg, 0, { force: true });
      }

      function atualizarAfazeres(msg) {
        if (state.afazeresAtualizacaoPromise) return state.afazeresAtualizacaoPromise;
        const promessa = Promise.resolve().then(async () => {
          const btn = $('#recarregarBtn');
          btn.disabled = true;
          loading(true);
          try {
            // Uma atualização explícita aguarda as gravações, sem bloquear novos cliques.
            while (haAfazeresPendentes()) {
              await Promise.all(Object.values(state.afazeresPendentes).map(p => p.promessa));
            }
            const revisao = state.afazeresRevisao;
            const dados = await server('fausCarregarAfazeresAtualizados');
            if (!dados || !Array.isArray(dados.tarefas) || !Array.isArray(dados.projetos)) {
              throw new Error('Resposta de afazeres inválida.');
            }
            if (!state.data && state.carregamentoInicial) await state.carregamentoInicial;
            if (!state.data) throw new Error('Carregamento inicial indisponível.');
            // A leitura pode ter começado antes de uma alteração otimista.
            if (revisao !== state.afazeresRevisao || haAfazeresPendentes()) return false;
            state.data.tarefas = dados.tarefas;
            state.data.projetos = dados.projetos;
            state.afazeresRevisao++;
            renderSemana();
            renderAfazeres();
            if (msg) toast(msg);
            return true;
          } catch (e) {
            toast('Erro ao atualizar afazeres: ' + e.message, true);
            return false;
          } finally {
            btn.disabled = false;
            loading(false);
          }
        }).finally(() => { state.afazeresAtualizacaoPromise = null; });
        state.afazeresAtualizacaoPromise = promessa;
        return promessa;
      }

      async function carregarCompletoEmSegundoPlano(msg) {
        loading(true);
        try {
          const revisaoAfazeres = state.afazeresRevisao;
          const [dados, afazeres] = await Promise.all([
            server('fausBootstrap'),
            server('fausCarregarAfazeresAtualizados').catch(e => {
              toast('Erro ao atualizar afazeres: ' + e.message, true);
              return state.data || { tarefas: [], projetos: [] };
            })
          ]);
          if (!afazeres || !Array.isArray(afazeres.tarefas) || !Array.isArray(afazeres.projetos)) {
            throw new Error('Resposta de afazeres inválida.');
          }
          dados.tarefas = afazeres.tarefas;
          dados.projetos = afazeres.projetos;
          if (state.data && (state.afazeresRevisao !== revisaoAfazeres || haAfazeresPendentes())) {
            dados.tarefas = state.data.tarefas;
            dados.projetos = state.data.projetos;
          }
          state.data = dados;
          render();
          if (msg) toast(msg);
          if (state.data.meta && state.data.meta.financeiroErro) {
            toast('Financeiro alternativo: ' + state.data.meta.financeiroErro, true);
          }
          if (state.data.meta && state.data.meta.bootstrapErro) {
            toast('Painel carregou com avisos: ' + state.data.meta.bootstrapErro, true);
          }
        } catch (e) {
          toast('Painel abriu, mas os dados demoraram: ' + e.message, true);
        } finally {
          loading(false);
        }
      }


        if (check.disabled) return Promise.resolve(false);
        return gravarAfazerComFeedback(id,
          () => aplicarToggleAfazerLocal(id, ocorrenciaData, concluido),
          'fausAlternarTarefa', [id, ocorrenciaData, concluido],
          concluido ? 'Tarefa concluída.' : 'Tarefa reaberta.');
      }

      function excluirAfazerComFeedback(id) {
        if (afazerPendente(id) || !confirm('Excluir este afazer?')) return Promise.resolve(false);
        return gravarAfazerComFeedback(id, tarefa => { tarefa.Ativo = 'Não'; },
          'fausExcluirTarefa', [id], 'Afazer excluído.');
      }

      function incrementarMetaComFeedback(meta) {
        if (meta.disabled) return Promise.resolve(false);
        const id = meta.dataset.id;
        const key = weekKey(new Date());
        return gravarAfazerComFeedback(id, tarefa => {
          const info = metaInfo(tarefa);
          const mapa = Object.assign({}, jsonSafe(tarefa.MetaSemanalJson, {}));
          mapa[key] = Math.min(info.qtd, info.feitos + 1);
          tarefa.MetaSemanalJson = JSON.stringify(mapa);
        }, 'fausIncrementarMetaSemanal', [id, key, 1]);
      }


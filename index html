      function initMapa() {
        if (state.map) {
          state.map.invalidateSize();
          return;
        }

        if (typeof L === 'undefined') {
          $('#map').innerHTML = `
            <div class="map-empty-state">
              <strong>Carregando biblioteca do mapa...</strong>
              <p style="font-size: 10px; margin-top: 4px;">Se demorar, verifique a conexão com a internet.</p>
            </div>
          `;
          setTimeout(initMapa, 400);
          return;
        }

        try {
          const latBase = -20.8113;
          const lngBase = -49.3758;

          state.map = L.map('map', {
            zoomControl: true,
            scrollWheelZoom: true
          }).setView([latBase, lngBase], 13);

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
          }).addTo(state.map);

          state.markersLayer = L.layerGroup().addTo(state.map);

          // Evento de clique no mapa para capturar coordenadas
          state.map.on('click', e => {
            const lat = e.latlng.lat.toFixed(6);
            const lng = e.latlng.lng.toFixed(6);

            const latInput = $('#pontoLat');
            const lngInput = $('#pontoLng');
            if (latInput) latInput.value = lat;
            if (lngInput) lngInput.value = lng;

            if (state.tempMarker) {
              state.map.removeLayer(state.tempMarker);
            }

            state.tempMarker = L.circleMarker([lat, lng], {
              radius: 9,
              fillColor: '#caeb88',
              color: '#0d2019',
              weight: 2,
              opacity: 1,
              fillOpacity: 0.9
            }).addTo(state.map).bindPopup('<b>Coordenada selecionada</b><br>Preencha o formulário e clique em Salvar.').openPopup();

            toast(`Coordenadas selecionadas: ${lat}, ${lng}`);
          });

          renderMapa();
        } catch (err) {
          $('#map').innerHTML = `
            <div class="map-empty-state">
              <strong>Erro ao iniciar o mapa:</strong>
              <p style="font-size: 11px;">${h(err.message)}</p>
            </div>
          `;
        }
      }

      function renderMapa() {
        if (!state.map || !state.markersLayer) return;
        state.markersLayer.clearLayers();

        const pontos = (state.data && state.data.pontos) || [];
        const bounds = [];

        pontos.forEach(p => {
          const lat = Number(p.Latitude);
          const lng = Number(p.Longitude);
          if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

          bounds.push([lat, lng]);

          let cor = '#1b6343';
          if (p.Tipo === 'Obra') cor = '#0d2019';
          else if (p.Tipo === 'Prospect' || p.Tipo === 'Oportunidade') cor = '#d89f36';

          const marker = L.circleMarker([lat, lng], {
            radius: 8,
            fillColor: cor,
            color: '#ffffff',
            weight: 2,
            opacity: 1,
            fillOpacity: 0.85
          });

          marker.bindPopup(`
            <div style="font-family: inherit; min-width: 160px;">
              <strong style="font-size: 12px; display: block; margin-bottom: 2px;">${h(p.Nome)}</strong>
              <span style="font-size: 10px; color: #666; display: block;">${h(p.Tipo)} · ${h(p.Status || 'Ativo')}</span>
              ${p.ClienteNome ? `<small style="display:block; margin-top:4px;"><b>Cliente:</b> ${h(p.ClienteNome)}</small>` : ''}
              ${p.Endereco ? `<small style="display:block;"><b>Endereço:</b> ${h(p.Endereco)}</small>` : ''}
              ${p.ProximaAcao ? `<small style="display:block; color:#1b6343; margin-top:4px;"><b>Próxima ação:</b> ${h(p.ProximaAcao)} (${dataBr(p.DataProximaAcao)})</small>` : ''}
            </div>
          `);

          state.markersLayer.addLayer(marker);
        });

        if (bounds.length > 0) {
          state.map.fitBounds(bounds, { padding: [30, 30], maxZoom: 15 });
        }
        setTimeout(() => state.map.invalidateSize(), 150);
      }

      function obterLocalizacao() {
        if (!navigator.geolocation) {
          toast('Geolocalização não suportada pelo navegador.', true);
          return;
        }
        loading(true);
        navigator.geolocation.getCurrentPosition(
          pos => {
            loading(false);
            const lat = pos.coords.latitude.toFixed(6);
            const lng = pos.coords.longitude.toFixed(6);

            const latInput = $('#pontoLat');
            const lngInput = $('#pontoLng');
            if (latInput) latInput.value = lat;
            if (lngInput) lngInput.value = lng;

            if (state.map) {
              state.map.setView([lat, lng], 16);
              if (state.tempMarker) state.map.removeLayer(state.tempMarker);
              state.tempMarker = L.circleMarker([lat, lng], {
                radius: 10,
                fillColor: '#2a835a',
                color: '#fff',
                weight: 3,
                fillOpacity: 0.9
              }).addTo(state.map).bindPopup('<b>Você está aqui</b>').openPopup();
            }
            toast('Localização atual obtida com sucesso.');
          },
          err => {
            loading(false);
            toast('Não foi possível obter a localização: ' + err.message, true);

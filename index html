      function renderSemana() {
        const inicioSemana = weekStart(new Date());
        const fimSemana = addDays(inicioSemana, 6);
        const semanaOcorrencias = gerarOcorrencias(inicioSemana, fimSemana);
        const comunsSemData = rawTarefas()
          .filter(t => tarefaTipo(t) === 'comum' && !t.Prazo)
          .map(t => ({ tarefa: t, concluida: tarefaConcluida(t), tipoExec: 'comum' }));
        const metas = rawTarefas()
          .filter(t => tarefaTipo(t) === 'meta')
          .map(t => ({ tarefa: t, concluida: metaInfo(t).concluida, tipoExec: 'meta' }));
        const execucao = comunsSemData
          .concat(semanaOcorrencias.map(o => Object.assign({}, o, { tipoExec: o.recorrente ? 'recorrente' : 'comum' })))
          .concat(metas);
        const total = execucao.length;
        const concluidos = execucao.filter(x => x.concluida).length;
        const pct = total ? Math.round((concluidos / total) * 100) : 0;
        const atrasados = execucao.filter(x => x.data && afazerStatusData(x.data, x.concluida) === 'atrasada').length;

        if (!total) {
          $('#semanaResumoCard').innerHTML = `
            <div class="week-card-header">
              <strong>Semana Atual</strong>
              <span class="badge">Aguardando afazeres</span>
            </div>
            <p style="margin:0; font-size:11px; color:var(--muted);">Nenhum afazer ativo na aba AFAZERES. Abra a central para cadastrar o primeiro.</p>
          `;
          $('#listaTarefasSemana').innerHTML = `<div class="empty-state">Sem tarefas pendentes na semana.</div>`;
          return;
        }

        $('#semanaResumoCard').innerHTML = `
          <div class="week-card-header">
            <strong>${concluidos} de ${total} concluídos</strong>
            <span class="badge ${pct === 100 ? 'green' : ''}">${pct}% concluído</span>
          </div>
          <div class="week-progress-bar">
            <span style="width: ${pct}%"></span>
          </div>
          ${atrasados ? `<div class="week-metas-wrap"><div class="week-meta-tag" style="color:var(--danger);">${atrasados} atrasado(s)</div></div>` : ''}
          ${metas.length ? `
            <div class="week-metas-wrap">
              ${metas.slice(0, 3).map(m => {
                const info = metaInfo(m.tarefa);
                return `<div class="week-meta-tag">${h(m.tarefa.Titulo)} · ${info.feitos}/${info.qtd}</div>`;
              }).join('')}
            </div>
          ` : ''}
        `;

        const pendentes = execucao
          .filter(x => !x.concluida)
          .sort((a, b) => {
            const ar = afazerStatusData(a.data, a.concluida);
            const br = afazerStatusData(b.data, b.concluida);
            const peso = s => s === 'atrasada' ? 0 : s === 'hoje' ? 1 : s === 'próxima' ? 2 : 3;
            const pa = peso(ar) + (tarefaPrioritaria(a.tarefa) ? -0.5 : 0);
            const pb = peso(br) + (tarefaPrioritaria(b.tarefa) ? -0.5 : 0);
            if (pa !== pb) return pa - pb;
            return String(a.data || '9999').localeCompare(String(b.data || '9999'));
          })
          .slice(0, 5);

        if (!pendentes.length) {
          $('#listaTarefasSemana').innerHTML = `
            <div class="empty-state" style="background: var(--surface-subtle); border: 1px solid var(--line);">
              Semana conquistada. Todos os afazeres relevantes estão concluídos.
            </div>
          `;
          return;
        }

        $('#listaTarefasSemana').innerHTML = pendentes.map(renderAfazerCard).join('');
      }

      function parseYmd(v) {
        if (!v) return null;
        const p = String(v).slice(0, 10).split('-').map(Number);
        if (p.length !== 3 || p.some(n => !Number.isFinite(n))) return null;
        return new Date(p[0], p[1] - 1, p[2]);
      }

      function addDays(d, n) {
        const x = new Date(d);
        x.setDate(x.getDate() + n);
        return x;
      }

      function weekStart(d) {
        const x = new Date(d);
        const day = x.getDay();
        x.setDate(x.getDate() + (day === 0 ? -6 : 1 - day));
        x.setHours(0, 0, 0, 0);
        return x;
      }

      function weekKey(d) {
        return localYmd(weekStart(d));
      }

      function jsonSafe(v, fallback) {
        if (!v) return fallback;
        if (typeof v === 'object') return v;
        try { return JSON.parse(v); } catch (e) { return fallback; }
      }

      function rawTarefas() {
        return (state.data && state.data.tarefas || []).filter(t => String(t.Ativo || 'Sim').toLowerCase() !== 'não');
      }

      function rawProjetos() {
        return (state.data && state.data.projetos || []).filter(p => {
          const ativo = String(p.Ativo || 'Sim').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
          return ativo !== 'nao';
        });
      }

      function projetoKey(id) {
        return String(id || '').replace(/\u00a0/g, ' ').trim();
      }

      function projetoNome(id) {
        const chave = projetoKey(id);
        const p = rawProjetos().find(x => projetoKey(x.ID) === chave);
        return p ? (p.Nome || p.Titulo || p.ID) : '';
      }

      function projetoPorId(id) {
        const chave = projetoKey(id);
        return rawProjetos().find(x => projetoKey(x.ID) === chave) || null;
      }

      function tarefaPrioritaria(t) {
        return String(t.Prioridade || '').toLowerCase().indexOf('prior') >= 0;
      }

      function tarefaTipo(t) {
        return String(t.TipoAfazer || 'comum').toLowerCase();
      }

      function tarefaConcluida(t) {
        return String(t.Status || '').toLowerCase().indexOf('concl') >= 0;
      }

      function ocorrenciaConcluida(t, data) {
        const mapa = jsonSafe(t.ConclusoesJson, {});
        return !!mapa[data];
      }

      function metaInfo(t) {
        const qtd = Math.max(1, Number(t.MetaSemanalQtd || 1));
        const key = weekKey(new Date());
        const mapa = jsonSafe(t.MetaSemanalJson, {});
        const feitos = Math.max(0, Number(mapa[key] || 0));
        return { key, qtd, feitos, concluida: feitos >= qtd };
      }

      function afazerPendenciaKey(id) {
        // Todas as ocorrências compartilham a mesma linha e os mesmos mapas JSON.
        return String(id || '__novo__');
      }

      function afazerPendente(id) {
        return !!state.afazeresPendentes[afazerPendenciaKey(id)];
      }

      function haAfazeresPendentes() {
        return Object.keys(state.afazeresPendentes).length > 0;
      }

      function serverAfazeres(fn, ...args) {
        return new Promise((resolve, reject) => {
          if (typeof google === 'undefined' || !google.script || !google.script.run) {
            reject(new Error('Ambiente Google Apps Script não detectado.'));
            return;
          }
          // O prazo local não cancela o Apps Script: manter a operação pendente
          // evita uma reversão falsa e um segundo envio enquanto ele ainda grava.
          const timer = setTimeout(() => {
            toast('O servidor está demorando. A gravação do afazer continua em andamento.', true);
          }, 45000);
          try {
            google.script.run
              .withSuccessHandler(res => { clearTimeout(timer); resolve(res); })
              .withFailureHandler(e => {
                clearTimeout(timer);
                reject(new Error(e && e.message ? e.message : String(e)));
              })[fn](...args);
          } catch (e) {
            clearTimeout(timer);
            reject(e);
          }
        });
      }

      function gravarAfazerComFeedback(id, aplicarLocal, fn, args, mensagem) {
        if (afazerPendente(id)) return Promise.resolve(false);
        if (!state.data) {
          toast('Aguarde o carregamento inicial dos afazeres.', true);
          return Promise.resolve(false);
        }
        const tarefa = (state.data && state.data.tarefas || []).find(t => String(t.ID) === String(id));
        if (id && !tarefa) {
          toast('Afazer não encontrado na tela. Atualize a lista.', true);
          return Promise.resolve(false);
        }
        const anterior = tarefa ? JSON.parse(JSON.stringify(tarefa)) : null;
        const key = afazerPendenciaKey(id);
        const pendencia = {};
        state.afazeresPendentes[key] = pendencia;
        try {
          if (aplicarLocal) aplicarLocal(tarefa);
        } catch (err) {
          restaurarAfazerLocal(id, anterior);
          delete state.afazeresPendentes[key];
          toast('Erro ao alterar afazer: ' + err.message, true);
          return Promise.resolve(false);
        }
        state.afazeresRevisao++;
        pendencia.promessa = Promise.resolve().then(() => serverAfazeres(fn, ...args)).then(resposta => {
          if (!resposta || resposta.ok !== true || !resposta.tarefa || !resposta.tarefa.ID || (id && String(resposta.tarefa.ID) !== String(id))) {
            throw new Error('O salvamento não foi confirmado pelo servidor.');
          }
          const tarefas = state.data.tarefas;
          const idx = tarefas.findIndex(t => String(t.ID) === String(resposta.tarefa.ID));
          if (idx < 0) tarefas.push(resposta.tarefa);
          else tarefas[idx] = resposta.tarefa;
          if (mensagem) toast(mensagem);
          return true;
        }).catch(err => {
          restaurarAfazerLocal(id, anterior);
          toast('Não foi possível salvar o afazer; a alteração local foi desfeita: ' + err.message, true);
          return false;
        }).finally(() => {
          delete state.afazeresPendentes[key];
          state.afazeresRevisao++;
          renderAfazeresLocais();
        });
        // O estado e todos os seus reflexos visuais mudam antes do primeiro await.
        renderAfazeresLocais();
        return pendencia.promessa;
      }

      function aplicarToggleAfazerLocal(id, ocorrenciaData, concluido) {
        const tarefas = state.data && state.data.tarefas || [];
        const idx = tarefas.findIndex(t => String(t.ID) === String(id));
        if (idx < 0) throw new Error('Afazer não encontrado na tela.');
        const anterior = Object.assign({}, tarefas[idx]);
        if (ocorrenciaData) {
          const conclusoes = Object.assign({}, jsonSafe(tarefas[idx].ConclusoesJson, {}));
          if (concluido === false) delete conclusoes[ocorrenciaData];
          else conclusoes[ocorrenciaData] = true;
          tarefas[idx].ConclusoesJson = JSON.stringify(conclusoes);
        } else {
          tarefas[idx].Status = concluido === false ? 'Pendente' : 'Concluído';
        }
        return anterior;
      }

      function restaurarAfazerLocal(id, anterior) {
        const tarefas = state.data && state.data.tarefas || [];
        const idx = tarefas.findIndex(t => String(t.ID) === String(id));
        if (idx >= 0 && anterior) tarefas[idx] = anterior;
      }

      function renderAfazeresLocais() {
        renderSemana();
        renderAfazeres();
      }

      function gerarOcorrencias(inicio, fim) {
        const itens = [];
        rawTarefas().forEach(t => {
          const tipo = tarefaTipo(t);
          if (tipo !== 'recorrente') {
            const data = t.Prazo ? data_(t.Prazo) : '';
            if (data) {
              const d = parseYmd(data);
              if (d && d >= inicio && d <= fim) {
                itens.push({ tarefa: t, data, id: `${t.ID}@${data}`, concluida: tarefaConcluida(t), recorrente: false });
              }
            }
            return;
          }

          const recInicio = parseYmd(t.RecorrenciaInicio || t.Prazo || hoje()) || inicio;
          const recFim = parseYmd(t.RecorrenciaFim || '') || fim;
          const de = recInicio > inicio ? recInicio : inicio;
          const ate = recFim < fim ? recFim : fim;
          if (de > ate) return;

          if (String(t.RecorrenciaTipo || 'semanal').toLowerCase() === 'mensal') {
            const dias = String(t.RecorrenciaDiasMes || '').split(/[,\s]+/).map(Number).filter(n => n >= 1 && n <= 31);
            const d = new Date(de.getFullYear(), de.getMonth(), 1);
            while (d <= ate) {
              dias.forEach(dia => {
                const occ = new Date(d.getFullYear(), d.getMonth(), dia);
                if (occ.getMonth() === d.getMonth() && occ >= de && occ <= ate) {
                  const key = localYmd(occ);
                  itens.push({ tarefa: t, data: key, id: `${t.ID}@${key}`, concluida: ocorrenciaConcluida(t, key), recorrente: true });
                }
              });
              d.setMonth(d.getMonth() + 1);
            }
            return;
          }

          const diasSemana = String(t.RecorrenciaDiasSemana || '').split(/[,\s]+/).map(Number).filter(n => n >= 0 && n <= 6);
          for (let d = new Date(de); d <= ate; d = addDays(d, 1)) {
            if (diasSemana.includes(d.getDay())) {
              const key = localYmd(d);
              itens.push({ tarefa: t, data: key, id: `${t.ID}@${key}`, concluida: ocorrenciaConcluida(t, key), recorrente: true });
            }
          }
        });
        return itens.sort((a, b) => String(a.data).localeCompare(String(b.data)));
      }

      function data_(v) {
        return String(v || '').slice(0, 10);
      }

      function afazerStatusData(data, concluida) {
        if (!data || concluida) return '';
        const hj = hoje();
        const diff = Math.round((parseYmd(data) - parseYmd(hj)) / 86400000);
        if (diff < 0) return 'atrasada';
        if (diff === 0) return 'hoje';
        if (diff <= 3) return 'próxima';
        return '';
      }

      function syncProjetosAfazeres() {
        const projetos = rawProjetos();
        const select = $('#afazerProjetoID');
        if (select) {
          const atual = projetoKey(select.value);
          select.innerHTML = '<option value="">Sem projeto</option>' + projetos
            .map(p => `<option value="${h(projetoKey(p.ID))}">${h(p.Nome || p.Titulo || p.ID)}</option>`)
            .join('');
          select.value = projetos.some(p => projetoKey(p.ID) === atual) ? atual : '';
        }
        $$('.afazeres-view-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.afazerView === state.afazeresModo));
      }

      function renderAfazeres() {
        if (!state.data) return;
        if (!state.afazeresMes) state.afazeresMes = hoje().slice(0, 7) + '-01';
        if (!state.afazeresDia) state.afazeresDia = hoje();
        syncProjetosAfazeres();

        const inicioSemana = weekStart(new Date());
        const fimSemana = addDays(inicioSemana, 6);
        const semanaOcorrencias = gerarOcorrencias(inicioSemana, fimSemana);
        const comuns = rawTarefas().filter(t => tarefaTipo(t) === 'comum' && !t.Prazo);
        const metas = rawTarefas().filter(t => tarefaTipo(t) === 'meta');
        const execucao = comuns.map(t => ({ tarefa: t, concluida: tarefaConcluida(t), tipoExec: 'comum' }))
          .concat(semanaOcorrencias.map(o => Object.assign({}, o, { tipoExec: o.recorrente ? 'recorrente' : 'comum' })))
          .concat(metas.map(t => ({ tarefa: t, concluida: metaInfo(t).concluida, tipoExec: 'meta' })));
        const total = execucao.length;
        const concluidos = execucao.filter(x => x.concluida).length;
        const pct = total ? Math.round((concluidos / total) * 100) : 0;
        const atrasados = execucao.filter(x => x.data && afazerStatusData(x.data, x.concluida) === 'atrasada').length;
        const prioritarios = execucao.filter(x => tarefaPrioritaria(x.tarefa) && !x.concluida).length;

        $('#conquistaTrack').style.setProperty('--progress', pct);
        $('#afazeresTituloProgresso').textContent = pct >= 100 ? 'Semana conquistada' : `${pct}% da semana conquistada`;
        $('#afazeresResumoTexto').textContent = `${concluidos} concluídos de ${total || 0}. ${atrasados ? atrasados + ' atrasado(s) pedem atenção.' : 'Sem atrasos críticos no radar.'}`;
        $('#afazeresScore').innerHTML = [
          ['Concluídos', concluidos],
          ['Pendentes', Math.max(total - concluidos, 0)],
          ['Prioritários', prioritarios],
          ['Atrasados', atrasados]
        ].map(x => `<div><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join('');

        renderFrentes(execucao);
        renderCalendarioAfazeres();
        renderAfazeresDia();
        renderAfazeresLista(execucao);
      }

      function renderFrentes(execucao) {
        const areas = ['Comercial', 'Financeiro', 'Operação', 'Gestão'];
        $('#afazeresFrentes').innerHTML = areas.map(area => {
          const itens = execucao.filter(x => String(x.tarefa.Area || 'Gestão') === area);
          const done = itens.filter(x => x.concluida).length;
          const pct = itens.length ? Math.round((done / itens.length) * 100) : 0;
          return `
            <div class="workfront">
              <strong>${h(area)}</strong>
              <small>${done}/${itens.length} concluídos</small>
              <div class="workfront-bar"><span style="width:${pct}%"></span></div>
            </div>
          `;
        }).join('');
      }

      function renderCalendarioAfazeres() {
        const mesBase = parseYmd(state.afazeresMes);
        const inicioMes = new Date(mesBase.getFullYear(), mesBase.getMonth(), 1);
        const fimMes = new Date(mesBase.getFullYear(), mesBase.getMonth() + 1, 0);
        const inicioGrade = addDays(inicioMes, -inicioMes.getDay());
        const fimGrade = addDays(fimMes, 6 - fimMes.getDay());
        const ocorrencias = gerarOcorrencias(inicioGrade, fimGrade);
        const porDia = {};
        ocorrencias.forEach(o => {
          if (!porDia[o.data]) porDia[o.data] = [];
          porDia[o.data].push(o);
        });
        $('#afazeresMesTitulo').textContent = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric' }).format(inicioMes);
        const nomes = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
        const dias = nomes.map(n => `<div class="calendar-weekday">${n}</div>`);
        for (let d = new Date(inicioGrade); d <= fimGrade; d = addDays(d, 1)) {
          const key = localYmd(d);
          const itens = porDia[key] || [];
          const done = itens.filter(x => x.concluida).length;
          const pendentes = itens.length - done;
          const temPrioridade = itens.some(x => tarefaPrioritaria(x.tarefa) && !x.concluida);
          const overdue = key < hoje() && pendentes > 0;
          const cls = [
            'calendar-day',
            d.getMonth() !== inicioMes.getMonth() ? 'muted' : '',
            key === hoje() ? 'today' : '',
            key === state.afazeresDia ? 'selected' : '',
            temPrioridade ? 'priority' : '',
            overdue ? 'overdue' : ''
          ].filter(Boolean).join(' ');
          dias.push(`
            <button type="button" class="${cls}" data-dia="${key}">
              <span class="calendar-day-number">${d.getDate()}</span>
              ${itens.length ? `<span class="calendar-dotline"><i class="calendar-dot ${temPrioridade ? 'priority' : ''}"></i>${pendentes || itens.length}</span>` : '<span></span>'}
            </button>
          `);
        }
        $('#afazeresCalendario').innerHTML = dias.join('');
      }

      function renderAfazeresDia() {
        const data = state.afazeresDia || hoje();
        const d = parseYmd(data);
        $('#afazeresDiaTitulo').textContent = dataBr(data);
        const itens = gerarOcorrencias(d, d);
        $('#afazeresDiaLista').innerHTML = itens.length ? itens.map(renderAfazerCard).join('') : '<div class="afazer-empty">Nenhum afazer com data neste dia.</div>';
      }

      function renderAfazeresLista(execucao) {
        const exibidos = new Set(execucao.map(x => String(x.tarefa.ID)));
        const foraDaSemana = state.afazeresModo === 'projetos' ? [] : rawTarefas()
          .filter(t => !exibidos.has(String(t.ID)))
          .map(t => ({ tarefa: t, data: t.Prazo ? data_(t.Prazo) : '', concluida: tarefaConcluida(t), tipoExec: tarefaTipo(t) }));
        const ocorrenciasExibidas = new Set(execucao.filter(x => x.recorrente).map(x => `${x.tarefa.ID}@${x.data}`));
        const recorrentesConcluidas = state.afazeresModo === 'concluidas' ? rawTarefas()
          .filter(t => tarefaTipo(t) === 'recorrente')
          .flatMap(t => Object.entries(jsonSafe(t.ConclusoesJson, {}))
            .filter(([data, feita]) => feita && /^\d{4}-\d{2}-\d{2}$/.test(data) && !ocorrenciasExibidas.has(`${t.ID}@${data}`))
            .map(([data]) => ({ tarefa: t, data, concluida: true, recorrente: true, tipoExec: 'recorrente' }))) : [];
        const itens = execucao.concat(foraDaSemana, recorrentesConcluidas).filter(x => {
          if (state.afazeresModo === 'lista') return !x.concluida;
          if (state.afazeresModo === 'concluidas') return x.concluida;
          return true;
        }).sort((a, b) => {
          const ap = tarefaPrioritaria(a.tarefa) && !a.concluida ? 0 : 1;
          const bp = tarefaPrioritaria(b.tarefa) && !b.concluida ? 0 : 1;
          if (ap !== bp) return ap - bp;
          return String(a.data || '9999').localeCompare(String(b.data || '9999'));
        });
        if (state.afazeresModo === 'projetos') {
          renderAfazeresPorProjeto(itens);
          return;
        }
        const vazio = state.afazeresModo === 'concluidas' ? 'Nenhum afazer concluído.' : 'Nenhum afazer pendente.';
        $('#afazeresLista').innerHTML = itens.length ? itens.map(renderAfazerCard).join('') : `<div class="afazer-empty">${vazio}</div>`;
      }

      function renderAfazeresPorProjeto(itens) {
        const projetos = rawProjetos();
        const grupos = {};
        projetos.forEach(p => {
          const id = projetoKey(p.ID);
          if (id) grupos[id] = { id: id, nome: p.Nome || p.Titulo || p.ID, projeto: p, itens: [] };
        });
        itens.forEach(item => {
          const id = projetoKey(item.tarefa.ProjetoID);
          const key = id || '__sem_projeto';
          if (!grupos[key]) {
            grupos[key] = { id: id, nome: id ? (projetoNome(id) || 'Projeto não encontrado') : 'Sem projeto', projeto: projetoPorId(id), itens: [] };
          }
          grupos[key].itens.push(item);
        });
        const ordenados = Object.keys(grupos)
          .map(k => grupos[k])
          .filter(g => g.itens.length || g.id)
          .sort((a, b) => {
            if (!a.id) return 1;
            if (!b.id) return -1;
            return String(a.nome).localeCompare(String(b.nome));
          });
        $('#afazeresLista').innerHTML = ordenados.length ? ordenados.map(g => {
          const concluidas = g.itens.filter(x => x.concluida).length;
          const pendentes = Math.max(g.itens.length - concluidas, 0);
          return `
            <div class="project-group" data-projeto-id="${h(g.id)}">
              <div class="project-group-head">
                <div>
                  <strong>${h(g.nome)}</strong>
                  <small>${concluidas} concluída(s) · ${pendentes} pendente(s)</small>
                </div>
                ${g.id ? `<button class="afazer-mini-btn btn-editar-projeto" type="button" data-id="${h(g.id)}">Editar</button>` : ''}
              </div>
              <div class="afazer-stack">
                ${g.itens.length ? g.itens.map(renderAfazerCard).join('') : '<div class="afazer-empty">Nenhum afazer vinculado a este projeto.</div>'}
              </div>
            </div>
          `;
        }).join('') : '<div class="afazer-empty">Cadastre um projeto ou afazer para iniciar.</div>';
      }

      function renderAfazerCard(item) {
        const t = item.tarefa;
        const tipo = tarefaTipo(t);
        const meta = tipo === 'meta' ? metaInfo(t) : null;
        const done = meta ? meta.concluida : item.concluida;
        const data = item.data || t.Prazo || '';
        const statusData = afazerStatusData(data, done);
        const classes = ['afazer-card', tarefaPrioritaria(t) ? 'priority' : '', statusData === 'atrasada' ? 'overdue' : '', done ? 'done' : ''].filter(Boolean).join(' ');
        const occ = item.recorrente ? data : '';
        const tags = [
          `<span class="afazer-tag">${h(t.Area || 'Gestão')}</span>`,
          tarefaPrioritaria(t) ? '<span class="afazer-tag priority">Prioritário</span>' : '',
          data ? `<span class="afazer-tag ${statusData === 'atrasada' ? 'overdue' : ''}">${statusData ? h(statusData) + ' · ' : ''}${dataBr(data)}</span>` : '',
          t.ProjetoID ? `<span class="afazer-tag">${h(projetoNome(t.ProjetoID) || 'Projeto')}</span>` : '',
          tipo === 'meta' ? `<span class="afazer-tag meta">${meta.feitos}/${meta.qtd} na semana</span>` : '',
          tipo === 'recorrente' ? '<span class="afazer-tag">Recorrente</span>' : ''
        ].filter(Boolean).join('');
        const pending = afazerPendente(t.ID);
        const action = tipo === 'meta'
          ? `<button class="afazer-mini-btn btn-meta-mais" data-id="${h(t.ID)}" ${done || pending ? 'disabled' : ''} ${pending ? 'aria-busy="true"' : ''}>+1</button>`
          : `<button class="afazer-check ${done ? 'checked' : ''}" data-id="${h(t.ID)}" data-occ="${h(occ)}" data-done="${done ? '1' : '0'}" aria-label="${done ? 'Reabrir tarefa' : 'Concluir tarefa'}" ${pending ? 'disabled aria-busy="true"' : ''}>✓</button>`;
        return `
          <div class="${classes}" data-id="${h(t.ID)}">
            ${action}
            <div>
              <div class="afazer-title">${h(t.Titulo)}</div>
              <div class="afazer-meta">${tags}</div>
            </div>
            <div class="afazer-actions">
              <button class="afazer-mini-btn btn-editar-afazer" data-id="${h(t.ID)}" ${pending ? 'disabled' : ''}>Editar</button>
              <button class="afazer-mini-btn btn-excluir-afazer" data-id="${h(t.ID)}" ${pending ? 'disabled' : ''}>×</button>
            </div>
          </div>
        `;
      }

      function crmDados() {
        if (state.crmModoDemo) {
          if (!state.crmDemo) state.crmDemo = crmDemoInicial();
          return state.crmDemo;
        }
        const crm = state.crmReal || {};
        const clientes = crm.clientes || [];
        const mapaClientes = {};
        clientes.forEach(c => {
          mapaClientes[String(c.ID || '')] = c;
        });
        return (crm.oportunidades || []).map(o => crmNormalizarOportunidade(o, mapaClientes[String(o.ClienteID || '')]));
      }

      function crmNormalizarOportunidade(o, cliente) {
        cliente = cliente || {};
        const status = ['nao_solicitado', 'solicitado', 'enviado', 'aprovado', 'perdido'].includes(String(o.StatusOrcamento || ''))
          ? String(o.StatusOrcamento)
          : 'indisponivel';
        return {
          ID: o.ID,
          ClienteID: o.ClienteID || '',
          ClienteNome: o.ClienteNome || cliente.Nome || cliente.Empresa || 'Sem cliente',
          Empresa: cliente.Empresa || o.Empresa || '',
          Telefone: cliente.Telefone || o.Telefone || '',
          Titulo: o.Titulo || '',
          Servico: o.Servico || o.Titulo || '',
          Canal: o.Canal || 'Não identificado',
          ClienteCanalOrigem: cliente.CanalOrigem || cliente.Canal || '',
          Etapa: o.Etapa || '',
          ValorEstimado: o.ValorEstimado,
          ValorOrcamento: o.ValorOrcamento,
          ValorVendido: o.ValorVendido,
          StatusOrcamento: status,
          FollowupStatus: o.DataProximaAcao ? (String(o.DataProximaAcao) < hoje() ? 'atrasado' : 'pendente') : '',
          ProximaAcao: o.ProximaAcao || '',
          DataProximaAcao: o.DataProximaAcao || '',
          DataProximaAcaoHora: o.DataProximaAcao || '',
          MotivoPerda: o.MotivoPerda || '',
          DataSolicitacaoOrcamento: o.DataSolicitacaoOrcamento || '',
          DataEnvioOrcamento: o.DataEnvioOrcamento || '',
          DataAprovacaoOrcamento: o.DataAprovacaoOrcamento || '',
          DataPerdaOrcamento: o.DataPerdaOrcamento || '',
          CriadoEm: o.CriadoEm || '',
          AtualizadoEm: o.AtualizadoEm || ''
        };
      }

      function crmValorOrcamento(o) {
        if (o.ValorOrcamento !== undefined && o.ValorOrcamento !== null && String(o.ValorOrcamento).trim() !== '') {
          return valorNumero(o.ValorOrcamento);
        }
        return state.crmModoDemo ? valorNumero(o.ValorEstimado) : null;
      }

      function crmValorVendido(o) {
        if (o.ValorVendido !== undefined && o.ValorVendido !== null && String(o.ValorVendido).trim() !== '') {
          return valorNumero(o.ValorVendido);
        }
        return null;
      }

      function crmClientes(dados) {
        const vistos = {};
        dados.forEach(o => {
          vistos[o.ClienteID || o.ClienteNome || o.ID] = {
            ID: o.ClienteID || o.ID,
            Nome: o.ClienteNome,
            Empresa: o.Empresa,
            Telefone: o.Telefone,
            Canal: o.Canal
          };
        });
        return Object.keys(vistos).map(k => vistos[k]);
      }

      function crmClientesReais(oportunidades) {
        if (state.crmModoDemo || !state.crmReal) return crmClientes(oportunidades);
        const vistos = {};
        (state.crmReal.clientes || []).forEach(c => {
          const id = String(c.ID || c.Nome || c.Empresa || '').trim();
          if (!id) return;
          vistos[id] = {
            ID: id,
            ClienteID: c.ID || id,
            ClienteNome: c.Nome || c.Empresa || id,
            Empresa: c.Empresa || '',
            Telefone: c.Telefone || '',
            CanalOrigem: c.CanalOrigem || c.Canal || 'Não identificado',
            Canal: c.CanalOrigem || c.Canal || 'Não identificado',
            Titulo: '',
            Servico: '',
            StatusOrcamento: 'nao_solicitado',
            _clienteSemOportunidade: true
          };
        });
        oportunidades.forEach(o => {
          const id = String(o.ClienteID || o.ClienteNome || o.ID || '').trim();
          if (!id) return;
          const cliente = vistos[id] || {};
          vistos[id] = Object.assign({}, cliente, o, {
            ID: o.ID,
            CanalOrigem: cliente.CanalOrigem || o.ClienteCanalOrigem || '',
            Canal: cliente.CanalOrigem || o.ClienteCanalOrigem || cliente.Canal || o.Canal || 'Não identificado',
            _clienteSemOportunidade: false
          });
        });
        return Object.keys(vistos).map(k => vistos[k]);
      }

      function crmResumo(dados) {
        const clientesUnicos = new Set(dados.map(o => String(o.ClienteID || o.ClienteNome || o.ID)).filter(Boolean));
        const leads = clientesUnicos.size || dados.length;
        const statusDisponivel = dados.some(o => o.StatusOrcamento && o.StatusOrcamento !== 'indisponivel');
        const solicitados = statusDisponivel ? dados.filter(o => o.StatusOrcamento === 'solicitado') : null;
        const enviados = statusDisponivel ? dados.filter(o => o.StatusOrcamento === 'enviado') : null;
        const orcamentos = statusDisponivel ? dados.filter(o => o.StatusOrcamento !== 'nao_solicitado' && o.StatusOrcamento !== 'indisponivel') : null;
        const enviadosAbertos = statusDisponivel ? dados.filter(o => o.StatusOrcamento === 'enviado') : null;
        const aprovados = statusDisponivel ? dados.filter(o => o.StatusOrcamento === 'aprovado') : null;
        const perdidos = statusDisponivel ? dados.filter(o => o.StatusOrcamento === 'perdido') : null;
        const valores = dados.map(crmValorOrcamento).filter(v => v !== null && v > 0);
        const vendidos = dados.map(crmValorVendido).filter(v => v !== null && v > 0);
        const ticketMedio = valores.length ? valores.reduce((t, v) => t + v, 0) / valores.length : null;
        const ticketVendido = vendidos.length ? vendidos.reduce((t, v) => t + v, 0) / vendidos.length : null;
        const totalOrcado = valores.length ? valores.reduce((t, v) => t + v, 0) : null;
        const totalVendido = vendidos.length ? vendidos.reduce((t, v) => t + v, 0) : null;
        const taxaConversao = statusDisponivel && orcamentos.length ? Math.round((aprovados.length / orcamentos.length) * 100) : null;
        return { leads, oportunidades: dados.length, solicitados, enviados, orcamentos, enviadosAbertos, aprovados, perdidos, ticketMedio, ticketVendido, totalOrcado, totalVendido, taxaConversao, statusDisponivel };
      }

      function crmCanalChave(canal) {
        return canal && canal !== 'Não identificado' && CRM_CANAIS.includes(canal) ? canal : 'Outros';
      }

      function crmClientesCadastrados(clientes) {
        if (state.crmModoDemo || !state.crmReal) return clientes || [];
        return (clientes || []).filter(c => c.CanalOrigem || c.ClienteCanalOrigem || c._clienteSemOportunidade);
      }

      function crmPorCanal(oportunidades, clientes) {
        const mapa = {};
        CRM_CANAIS.filter(canal => canal !== 'Não identificado').forEach(canal => {
          mapa[canal] = { canal, leads: 0, oportunidades: 0, orcamentos: 0, aprovados: 0, perdidos: 0, valorOrcado: 0, valorVendido: 0, qtdOrcada: 0, qtdVendida: 0, _clientes: {} };
        });
        crmClientesCadastrados(clientes).forEach(c => {
          const canal = crmCanalChave(c.CanalOrigem || c.ClienteCanalOrigem || c.Canal);
          if (!mapa[canal]) mapa[canal] = { canal, leads: 0, oportunidades: 0, orcamentos: 0, aprovados: 0, perdidos: 0, valorOrcado: 0, valorVendido: 0, qtdOrcada: 0, qtdVendida: 0, _clientes: {} };
          const clienteKey = String(c.ClienteID || c.ClienteNome || c.ID || '').trim();
          if (clienteKey && !mapa[canal]._clientes[clienteKey]) {
            mapa[canal]._clientes[clienteKey] = true;
            mapa[canal].leads += 1;
          }
        });
        (oportunidades || []).forEach(o => {
          const canal = crmCanalChave(o.Canal);
          if (!mapa[canal]) mapa[canal] = { canal, leads: 0, oportunidades: 0, orcamentos: 0, aprovados: 0, perdidos: 0, valorOrcado: 0, valorVendido: 0, qtdOrcada: 0, qtdVendida: 0, _clientes: {} };
          mapa[canal].oportunidades += 1;
          if (o.StatusOrcamento !== 'nao_solicitado' && o.StatusOrcamento !== 'indisponivel') mapa[canal].orcamentos += 1;
          if (o.StatusOrcamento === 'aprovado') mapa[canal].aprovados += 1;
          if (o.StatusOrcamento === 'perdido') mapa[canal].perdidos += 1;
          const vo = crmValorOrcamento(o);
          const vv = crmValorVendido(o);
          if (vo !== null && vo > 0) {
            mapa[canal].valorOrcado += vo;
            mapa[canal].qtdOrcada += 1;
          }
          if (vv !== null && vv > 0) {
            mapa[canal].valorVendido += vv;
            mapa[canal].qtdVendida += 1;
          }
        });
        return CRM_CANAIS.filter(canal => canal !== 'Não identificado').map(canal => {
          const item = Object.assign({}, mapa[canal]);
          delete item._clientes;
          item.conversao = item.orcamentos ? Math.round((item.aprovados / item.orcamentos) * 100) : null;
          item.ticketOrcado = item.qtdOrcada ? item.valorOrcado / item.qtdOrcada : null;
          item.ticketVendido = item.qtdVendida ? item.valorVendido / item.qtdVendida : null;
          return item;
        });
      }

      function crmCanalVisivel(canal) {
        return canal === 'Não identificado' || !canal ? 'Outros' : canal;
      }

      function crmDataHoraBr(v) {
        if (!v) return 'Sem data';
        const d = new Date(v);
        if (Number.isNaN(d.getTime())) return dataBr(v);
        return new Intl.DateTimeFormat('pt-BR', {
          day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'
        }).format(d);
      }

      function crmStatusLabel(status) {
        return {
          nao_solicitado: 'Orçamento não solicitado',
          solicitado: 'Orçamento solicitado',
          enviado: 'Orçamento enviado',
          aprovado: 'Aprovado',
          perdido: 'Perdido',
          indisponivel: 'Indisponível'
        }[status] || 'Em análise';
      }

      function crmStatusVisivel(o) {
        return o && o._clienteSemOportunidade ? 'Cadastrado' : crmStatusLabel(o && o.StatusOrcamento);
      }

      function crmStatusClasse(status) {
        if (status === 'aprovado') return 'meta';
        if (status === 'perdido') return 'overdue';
        if (status === 'enviado') return 'priority';
        return '';
      }

      function crmFollowLabel(status) {
        return {
          pendente: 'Pendente',
          atrasado: 'Atrasado',
          concluido: 'Concluído'
        }[status] || 'Pendente';
      }

      function crmAgendarFollowup3h(o) {
        const data = new Date();
        data.setHours(data.getHours() + 3);
        o.DataProximaAcaoHora = data.toISOString();
        o.DataProximaAcao = localYmd(data);
        o.ProximaAcao = 'Follow-up automático 3h após envio';
        o.FollowupStatus = 'pendente';
      }

      function crmAtualizarStatus(item, status) {
        item.StatusOrcamento = status;
        if (status === 'nao_solicitado') {
          item.Etapa = 'Novo lead';
          item.ProximaAcao = item.ProximaAcao || 'Entender necessidade comercial';
          item.FollowupStatus = item.FollowupStatus === 'concluido' ? 'concluido' : 'pendente';
        }
        if (status === 'solicitado') {
          item.Etapa = 'Orçamento necessário';
          item.ProximaAcao = 'Preparar orçamento';
          item.FollowupStatus = 'pendente';
        }
        if (status === 'enviado') {
          item.Etapa = 'Proposta enviada';
          crmAgendarFollowup3h(item);
        }
        if (status === 'aprovado') {
          item.Etapa = 'Fechado';
          item.FollowupStatus = 'concluido';
          item.ProximaAcao = 'Aprovado, preparar execução';
        }
        if (status === 'perdido') {
          item.Etapa = 'Perdido';
          item.FollowupStatus = 'concluido';
          item.MotivoPerda = item.MotivoPerda || 'Motivo simulado para avaliação do fluxo';
          item.ProximaAcao = 'Perdido, registrar aprendizado';
        }
      }

      function crmPromptValor(label, atual) {
        const base = atual == null || atual === '' ? '' : String(atual);
        const valor = prompt(label, base);
        return valor === null ? null : String(valor).trim();
      }

      function crmPromptDataHora(label, atual) {
        const base = atual ? String(atual).slice(0, 16) : '';
        const valor = prompt(label + ' (AAAA-MM-DD ou AAAA-MM-DDTHH:MM)', base || amanha());
        return valor === null ? null : String(valor).trim();
      }

      async function crmAcao(id, acao) {
        const item = crmDados().find(o => String(o.ID) === String(id));
        if (!item) return;
        if (!state.crmModoDemo) {
          if (acao === 'followup') {
            const desc = prompt('O que foi feito neste acompanhamento?', 'Follow-up comercial realizado');
            if (desc === null) return;
            const novaAcao = prompt('Nova ação comercial (opcional):', '');
            if (novaAcao === null) return;
            let novaData = '';
            if (String(novaAcao || '').trim()) {
              novaData = crmPromptDataHora('Data do novo acompanhamento', item.DataProximaAcaoHora || item.DataProximaAcao);
              if (novaData === null) return;
              if (!novaData) {
                toast('Informe a data do novo acompanhamento.', true);
                return;
              }
            }
            loading(true);
            try {
              await server('fausConcluirAcompanhamentoCRM', {
                OportunidadeID: id,
                Descricao: desc || 'Acompanhamento comercial realizado.',
                ProximaAcao: novaAcao || '',
                DataProximaAcao: novaData || ''
              });
              toast('Acompanhamento atualizado.');
              await carregarCRMSePreciso(true);
            } catch (err) {
              toast('Erro no acompanhamento: ' + err.message, true);
            } finally {
              loading(false);
            }
            return;
          }
          if (acao === 'novo-followup') {
            const novaAcao = prompt('Qual é a próxima ação comercial?', item.ProximaAcao || 'Fazer follow-up');
            if (!novaAcao) return;
            const novaData = crmPromptDataHora('Data do acompanhamento', item.DataProximaAcaoHora || item.DataProximaAcao);
            if (!novaData) return;
            loading(true);
            try {
              await server('fausAtualizarAcompanhamentoCRM', {
                OportunidadeID: id,
                ProximaAcao: novaAcao,
                DataProximaAcao: novaData
              });
              toast('Novo acompanhamento agendado.');
              await carregarCRMSePreciso(true);
            } catch (err) {
              toast('Erro ao agendar acompanhamento: ' + err.message, true);
            } finally {
              loading(false);
            }
            return;
          }
        }
        if (acao === 'enviar') {
          crmAtualizarStatus(item, 'enviado');
          toast('Orçamento marcado como enviado. Follow-up simulado para daqui 3 horas.');
        }
        if (acao === 'followup') {
          item.FollowupStatus = 'concluido';
          item.ProximaAcao = 'Follow-up realizado';
          toast('Follow-up marcado como realizado na demonstração.');
        }
        if (acao === 'aprovar') {
          crmAtualizarStatus(item, 'aprovado');
          toast('Oportunidade aprovada na demonstração.');
        }
        if (acao === 'perder') {
          crmAtualizarStatus(item, 'perdido');
          toast('Oportunidade perdida na demonstração.');
        }
        if (acao === 'status') {
          crmAtualizarStatus(item, item._novoStatus || 'nao_solicitado');
          toast('Situação comercial atualizada na demonstração.');
          delete item._novoStatus;
        }
        renderCRM();
      }

      async function crmAplicarStatus(id, status) {
        const item = crmDados().find(o => String(o.ID) === String(id));
        if (!item) return;
        if (!state.crmModoDemo) {
          const payload = { OportunidadeID: id, StatusOrcamento: status };
          if (['solicitado', 'enviado', 'aprovado', 'perdido'].includes(status)) {
            const valorOrcado = crmPromptValor('Valor do orçamento (deixe vazio se desconhecido)', item.ValorOrcamento || '');
            if (valorOrcado === null) return;
            if (valorOrcado) payload.ValorOrcamento = valorOrcado;
          }
          if (status === 'aprovado') {
            const valorVendido = crmPromptValor('Valor efetivamente vendido (opcional)', item.ValorVendido || item.ValorOrcamento || '');
            if (valorVendido === null) return;
            if (valorVendido) payload.ValorVendido = valorVendido;
          }
          if (status === 'perdido') {
            const motivo = prompt('Motivo da perda (opcional):', item.MotivoPerda || '');
            if (motivo === null) return;
            if (motivo) payload.MotivoPerda = motivo;
          }
          loading(true);
          try {
            await server('fausAtualizarOrcamentoCRM', payload);
            toast('Orçamento atualizado com sucesso.');
            await carregarCRMSePreciso(true);
          } catch (err) {
            toast('Erro ao atualizar orçamento: ' + err.message, true);
          } finally {
            loading(false);
          }
          return;
        }
        item._novoStatus = status;
        crmAcao(id, 'status');
      }

      function crmEventosRecentes(dados) {
        const eventos = [];
        dados.forEach((o, i) => {
          if (!state.crmModoDemo) {
            if (o.CriadoEm) {
              eventos.push({
                id: o.ID + '-novo',
                data: o.CriadoEm,
                tipo: 'Novo contato',
                cliente: o.ClienteNome,
                detalhe: o.Empresa || o.Servico || 'Cliente recebido'
              });
            }
            [
              ['DataSolicitacaoOrcamento', 'Orçamento solicitado'],
              ['DataEnvioOrcamento', 'Orçamento enviado'],
              ['DataAprovacaoOrcamento', 'Orçamento aprovado'],
              ['DataPerdaOrcamento', 'Orçamento perdido']
            ].forEach(cfg => {
              if (!o[cfg[0]]) return;
              eventos.push({
                id: o.ID + '-' + cfg[0],
                data: o[cfg[0]],
                tipo: cfg[1],
                cliente: o.ClienteNome,
                detalhe: `${crmCanalVisivel(o.Canal)} · ${crmValorOrcamento(o) ? dinheiro(crmValorOrcamento(o)) : 'valor não informado'}`
              });
            });
            if (o.AtualizadoEm && !o.DataEnvioOrcamento && !o.DataAprovacaoOrcamento && !o.DataPerdaOrcamento) {
              eventos.push({
                id: o.ID + '-atualizado',
                data: o.AtualizadoEm,
                tipo: 'Atualização comercial',
                cliente: o.ClienteNome,
                detalhe: o.ProximaAcao || crmStatusLabel(o.StatusOrcamento)
              });
            }
            return;
          }
          const dataBase = o.AtualizadoEm || o.CriadoEm || (state.crmModoDemo ? (o.DataProximaAcaoHora || o.DataProximaAcao) : '');
          if (!dataBase && !state.crmModoDemo) return;
          const base = new Date(dataBase || new Date());
          const criado = new Date(base);
          criado.setDate(criado.getDate() - (i % 4));
          eventos.push({
            id: o.ID + '-novo',
            data: o.CriadoEm || criado.toISOString(),
            tipo: 'Novo contato',
            cliente: o.ClienteNome,
            detalhe: o.Empresa || o.Servico || 'Cliente recebido'
          });
          if (o.StatusOrcamento !== 'nao_solicitado' && o.StatusOrcamento !== 'indisponivel') {
            const env = new Date(base);
            env.setHours(env.getHours() - 3);
            eventos.push({
              id: o.ID + '-orcamento',
              data: o.AtualizadoEm || env.toISOString(),
              tipo: crmStatusLabel(o.StatusOrcamento),
              cliente: o.ClienteNome,
              detalhe: `${crmCanalVisivel(o.Canal)} · ${crmValorOrcamento(o) ? dinheiro(crmValorOrcamento(o)) : 'valor não informado'}`
            });
          }
        });
        return eventos.sort((a, b) => String(b.data).localeCompare(String(a.data)));
      }

      function crmListaComMais(selector, itens, limite, renderItem, vazio, action) {
        const visiveis = itens.slice(0, limite);
        const mais = itens.length > limite ? `<button class="secondary-btn full crm-more" type="button" data-crm-more="${h(action)}">Mostrar mais</button>` : '';
        $(selector).innerHTML = visiveis.length ? visiveis.map(renderItem).join('') + mais : `<div class="afazer-empty">${h(vazio)}</div>`;
      }

      function renderCRM() {
        if (!state.data) return;
        const oportunidades = crmDados();
        const clientesCrm = crmClientesReais(oportunidades);
        const clientesCadastrados = crmClientesCadastrados(clientesCrm);
        const resumo = crmResumo(oportunidades);
        const statusOptions = [
          ['nao_solicitado', 'Não solicitado'],
          ['solicitado', 'Solicitado'],
          ['enviado', 'Enviado'],
          ['aprovado', 'Aprovado'],
          ['perdido', 'Perdido']
        ];
        const novoCanalInicial = $('#crmNovoCanal');
        if (novoCanalInicial && !novoCanalInicial.options.length) {
          novoCanalInicial.innerHTML = CRM_CANAIS.map(c => `<option value="${h(c)}">${h(c)}</option>`).join('');
          novoCanalInicial.value = 'Não identificado';
        }
        const estadoCRM = msg => {
          $('#crmResumoPulso').innerHTML = `<div class="empty-state" style="padding: 14px;">${h(msg)}</div>`;
          $('#crmScore').innerHTML = '';
          $('#crmCanaisResumo').innerHTML = `<div class="empty-state">${h(msg)}</div>`;
          $('#crmAcompanhamentosTab').innerHTML = `<div class="afazer-empty">${h(msg)}</div>`;
          $('#crmRecentesTab').innerHTML = `<div class="afazer-empty">${h(msg)}</div>`;
          $('#crmClientesTab').innerHTML = `<div class="afazer-empty">${h(msg)}</div>`;
          $('#crmDetalheTitulo').textContent = 'CRM';
          $('#crmDetalhe').innerHTML = `<div class="empty-state">${h(msg)}</div>`;
        };

        if (!state.crmModoDemo && state.crmCarregando) {
          if ($('#crmModoBadge')) {
            $('#crmModoBadge').textContent = 'Carregando dados reais';
            $('#crmModoBadge').className = 'badge gold';
          }
          $('#crmTituloResumo').textContent = 'Carregando dados reais';
          $('#crmResumoTexto').textContent = 'Lendo CLIENTES e OPORTUNIDADES pelo Apps Script.';
          estadoCRM('Carregando dados reais do CRM...');
          return;
        }
        if (!state.crmModoDemo && state.crmErro) {
          if ($('#crmModoBadge')) {
            $('#crmModoBadge').textContent = 'Erro na leitura';
            $('#crmModoBadge').className = 'badge danger';
          }
          $('#crmTituloResumo').textContent = 'Erro ao carregar CRM';
          $('#crmResumoTexto').textContent = state.crmErro;
          estadoCRM('Não foi possível carregar os dados reais do CRM.');
          return;
        }
        if (!state.crmModoDemo && state.crmReal && !clientesCrm.length) {
          if ($('#crmModoBadge')) {
            $('#crmModoBadge').textContent = 'Dados reais — vazio';
            $('#crmModoBadge').className = 'badge gold';
          }
          $('#crmTituloResumo').textContent = 'CRM sem clientes';
          $('#crmResumoTexto').textContent = 'Nenhum cliente real foi encontrado em CLIENTES.';
          estadoCRM('Nenhum registro real encontrado.');
          return;
        }
        if ($('#crmModoBadge')) {
          $('#crmModoBadge').textContent = state.crmModoDemo ? 'Dados fictícios — demonstração' : 'Dados reais — leitura e gravação';
          $('#crmModoBadge').className = 'badge ' + (state.crmModoDemo ? 'gold' : 'green');
        }
        const q = String(state.crmBusca || '').trim().toLowerCase();
        const clientesFiltrados = clientesCrm.filter(o => {
          const texto = [o.ClienteNome, o.Empresa, o.Servico, o.Titulo].join(' ').toLowerCase();
          const canalOk = !state.crmCanalFiltro || crmCanalVisivel(o.Canal) === state.crmCanalFiltro;
          const statusOk = !state.crmStatusFiltro || o.StatusOrcamento === state.crmStatusFiltro;
          return (!q || texto.includes(q)) && canalOk && statusOk;
        });
        const followups = oportunidades
          .filter(o => (o.ProximaAcao || o.FollowupStatus) && o.FollowupStatus !== 'concluido')
          .sort((a, b) => {
            const ordem = { atrasado: 0, pendente: 1, concluido: 2 };
            const sa = ordem[a.FollowupStatus] ?? 1;
            const sb = ordem[b.FollowupStatus] ?? 1;
            if (sa !== sb) return sa - sb;
            return String(a.DataProximaAcaoHora || a.DataProximaAcao || '9999').localeCompare(String(b.DataProximaAcaoHora || b.DataProximaAcao || '9999'));
          });

        if (!state.crmSelecionado || !oportunidades.concat(clientesCrm).some(o => String(o.ID) === String(state.crmSelecionado))) {
          state.crmSelecionado = oportunidades[0] ? oportunidades[0].ID : (clientesCrm[0] ? clientesCrm[0].ID : '');
        }
        const selecionado = oportunidades.find(o => String(o.ID) === String(state.crmSelecionado))
          || clientesCrm.find(o => String(o.ID) === String(state.crmSelecionado))
          || oportunidades[0]
          || clientesCrm[0]
          || null;
        if ($('#crmAtualizarDados')) $('#crmAtualizarDados').textContent = state.crmModoDemo ? 'Recalcular indicadores' : 'Recarregar dados reais';
        if ($('#crmResetDemo')) $('#crmResetDemo').style.display = state.crmModoDemo ? 'inline-flex' : 'none';

        $('#crmTituloResumo').textContent = state.crmModoDemo
          ? 'Dados fictícios para testar o fluxo'
          : `${oportunidades.length} oportunidade(s) no radar`;
        $('#crmResumoTexto').textContent = state.crmModoDemo
          ? (state.crmModoDemo ? 'Modo demonstração local: ações alteram somente a memória desta tela e não gravam em planilhas.' : 'Leitura real ativa: dados carregados de CLIENTES e OPORTUNIDADES.')
          : 'Indicadores calculados a partir dos registros reais. Ações rápidas gravam em CLIENTES, OPORTUNIDADES e INTERACOES.';

        $('#crmResumoPulso').innerHTML = `
          <div class="pulse-item"><span>Clientes recebidos</span><strong>${clientesCadastrados.length || resumo.leads}</strong></div>
          <div class="pulse-item"><span>Orçamentos enviados</span><strong>${resumo.enviados ? resumo.enviados.length : 'Indisponível'}</strong></div>
          <div class="pulse-item"><span>Taxa de conversão</span><strong>${resumo.taxaConversao === null ? 'Indisponível' : resumo.taxaConversao + '%'}</strong></div>
        `;

        $('#crmScore').innerHTML = [
          ['Clientes', clientesCadastrados.length || resumo.leads],
          ['Solicitados', resumo.solicitados ? resumo.solicitados.length : 'Indisponível'],
          ['Enviados', resumo.enviados ? resumo.enviados.length : 'Indisponível'],
          ['Aprovados', resumo.aprovados ? resumo.aprovados.length : 'Indisponível'],
          ['Perdidos', resumo.perdidos ? resumo.perdidos.length : 'Indisponível'],
          ['Conversão', resumo.taxaConversao === null ? 'Indisponível' : resumo.taxaConversao + '%'],
          ['Ticket médio orçado', resumo.ticketMedio === null ? 'Indisponível' : dinheiro(resumo.ticketMedio)],
          ['Ticket médio vendido', resumo.ticketVendido === null ? 'Indisponível' : dinheiro(resumo.ticketVendido)],
          ['Total orçado', resumo.totalOrcado === null ? 'Indisponível' : dinheiro(resumo.totalOrcado)],
          ['Total vendido', resumo.totalVendido === null ? 'Indisponível' : dinheiro(resumo.totalVendido)]
        ].map(x => `<div><span>${h(x[0])}</span><strong>${h(x[1])}</strong></div>`).join('');

        const canais = crmPorCanal(oportunidades, clientesCadastrados);
        const maiorCanal = Math.max.apply(null, canais.map(c => c.leads).concat([0]));
        $('#crmCanaisResumo').innerHTML = canais.map(c => {
          const pct = maiorCanal ? Math.round((c.leads / maiorCanal) * 100) : 0;
          return `
            <div class="workfront">
              <strong>${h(c.canal)}</strong>
              <small>${c.leads} clientes · ${c.oportunidades} ops · ${c.orcamentos} orç. · ${c.aprovados} vendas · ${c.conversao === null ? 'conv. n/d' : c.conversao + '%'}</small>
              <small>${c.qtdOrcada ? dinheiro(c.valorOrcado) + ' orçado · TM ' + dinheiro(c.ticketOrcado) : 'orçado indisponível'} · ${c.qtdVendida ? dinheiro(c.valorVendido) + ' vendido · TM ' + dinheiro(c.ticketVendido) : 'vendido indisponível'}</small>
              <div class="workfront-bar"><span style="width:${pct}%"></span></div>
            </div>
          `;
        }).join('');

        $$('.crm-tab').forEach(btn => btn.classList.toggle('active', btn.dataset.crmTab === state.crmTab));
        $('#crmAcompanhamentosTab').style.display = state.crmTab === 'acompanhamentos' ? 'grid' : 'none';
        $('#crmRecentesTab').style.display = state.crmTab === 'recentes' ? 'grid' : 'none';
        $('#crmClientesToolbar').style.display = state.crmTab === 'clientes' ? 'grid' : 'none';
        $('#crmClientesTab').style.display = state.crmTab === 'clientes' ? 'grid' : 'none';

        const canalSelect = $('#crmFiltroCanal');
        const statusSelect = $('#crmFiltroStatus');
        const novoCanal = $('#crmNovoCanal');
        if (canalSelect) {
          canalSelect.innerHTML = '<option value="">Todos os canais</option>' + CRM_CANAIS.filter(c => c !== 'Não identificado').map(c => `<option value="${h(c)}">${h(c)}</option>`).join('');
          canalSelect.value = state.crmCanalFiltro || '';
        }
        if (novoCanal && !novoCanal.options.length) {
          novoCanal.innerHTML = CRM_CANAIS.map(c => `<option value="${h(c)}">${h(c)}</option>`).join('');
          novoCanal.value = 'Não identificado';
        }
        if (statusSelect) {
          statusSelect.innerHTML = '<option value="">Todas as situações</option>' + statusOptions.map(s => `<option value="${h(s[0])}">${h(s[1])}</option>`).join('');
          statusSelect.value = state.crmStatusFiltro || '';
        }
        if ($('#crmBusca') && $('#crmBusca').value !== state.crmBusca) $('#crmBusca').value = state.crmBusca || '';

        crmListaComMais('#crmClientesTab', clientesFiltrados, state.crmLimitClientes, o => `
          <button type="button" class="crm-client-row ${String(o.ID) === String(state.crmSelecionado) ? 'active' : ''}" data-crm-select="${h(o.ID)}">
            <div>
              <div class="crm-client-title">
                <strong>${h(o.ClienteNome)}</strong>
                <span class="afazer-tag ${crmStatusClasse(o.StatusOrcamento)}">${h(crmStatusVisivel(o))}</span>
              </div>
              <div class="crm-client-meta">
                <span class="afazer-tag priority">${h(crmCanalVisivel(o.Canal))}</span>
                <span class="afazer-tag">${h(o.Empresa || 'Sem empresa')}</span>
                <span class="afazer-tag">${h(o._clienteSemOportunidade ? 'Sem oportunidade vinculada' : (o.Servico || o.Titulo || 'Serviço não informado'))}</span>
              </div>
            </div>
            <span class="afazer-mini-btn">Ver</span>
          </button>
        `, 'Nenhum cliente encontrado nos filtros atuais.', 'clientes');

        crmListaComMais('#crmAcompanhamentosTab', followups, state.crmLimitAcompanhamentos, o => {
          const statusClass = o.FollowupStatus === 'atrasado' ? 'overdue' : 'priority';
          const cardClass = ['afazer-card', o.FollowupStatus === 'atrasado' ? 'overdue' : ''].filter(Boolean).join(' ');
          return `
            <div class="${cardClass}">
              <button class="afazer-check crm-action" data-id="${h(o.ID)}" data-action="followup" aria-label="Marcar follow-up realizado">✓</button>
              <div>
                <div class="afazer-title">${h(o.ProximaAcao || 'Acompanhar oportunidade')}</div>
                <div class="afazer-meta">
                  <span class="afazer-tag">${h(o.ClienteNome)}</span>
                  <span class="afazer-tag ${statusClass}">${crmFollowLabel(o.FollowupStatus)}</span>
                  <span class="afazer-tag">${crmDataHoraBr(o.DataProximaAcaoHora || o.DataProximaAcao)}</span>
                </div>
              </div>
              <div class="afazer-actions">
                <button class="afazer-mini-btn" data-crm-select="${h(o.ID)}">Ver</button>
              </div>
            </div>
          `;
        }, 'Nenhum acompanhamento comercial pendente.', 'acompanhamentos');

        crmListaComMais('#crmRecentesTab', crmEventosRecentes(oportunidades), state.crmLimitRecentes, ev => `
          <div class="afazer-card">
            <span class="afazer-check checked" aria-hidden="true">✓</span>
            <div>
              <div class="afazer-title">${h(ev.tipo)} · ${h(ev.cliente)}</div>
              <div class="afazer-meta">
                <span class="afazer-tag">${crmDataHoraBr(ev.data)}</span>
                <span class="afazer-tag">${h(ev.detalhe)}</span>
              </div>
            </div>
          </div>
        `, 'Nenhuma movimentação comercial recente.', 'recentes');

        if (!selecionado) {
          $('#crmDetalheTitulo').textContent = 'Selecione um cliente';
          $('#crmDetalhe').innerHTML = '<div class="empty-state">Nenhum cliente disponível.</div>';
          return;
        }

        $('#crmDetalheTitulo').textContent = selecionado.ClienteNome || 'Cliente';

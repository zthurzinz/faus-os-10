<script>
(function () {
  'use strict';
  const S = { tab: 'calendario', cache: {}, pending: {}, errors: {}, week: '', day: '', filters: {
    calendario: { formato: '', responsavel: '', status: '' }, gaveta: { busca: '', formato: '', status: '' }
  } };
  const functions = { calendario: 'fausMarketingCalendario', prompts: 'fausMarketingPrompts', gaveta: 'fausMarketingGaveta' };
  const root = () => document.getElementById('view-marketing');
  const q = selector => root().querySelector(selector);
  const h = v => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const norm = v => String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');
  const text = v => h(v || 'Não informado');
  const dateBr = iso => iso ? iso.slice(0, 10).split('-').reverse().join('/') : 'Sem data';
  const plus = (iso, days) => { const d = new Date(iso + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + days); return d.toISOString().slice(0, 10); };
  const format = value => ({ storystatus: 'Story / Status', story: 'Story', stories: 'Story', status: 'Status', reel: 'Reel', reels: 'Reel', google: 'Google' }[norm(value)] || value || 'Formato não informado');
  const empty = message => '<p class="mkt-empty">' + h(message) + '</p>';
  const badge = value => '<span class="mkt-badge">' + text(value) + '</span>';

  function links(value) {
    const urls = String(value || '').match(/https?:\/\/[^\s<>"']+/gi) || [];
    return urls.map(raw => {
      const url = raw.replace(/[).,;]+$/, '');
      try { if (!['http:', 'https:'].includes(new URL(url).protocol)) return ''; } catch (_) { return ''; }
      return '<a href="' + h(url) + '" target="_blank" rel="noopener noreferrer">Abrir referência ↗</a>';
    }).join(' ');
  }

  function init() {
    if (root().dataset.mktReady) return;
    root().dataset.mktReady = '1';
    root().innerHTML = `
      <div class="mkt-intro"><p>Planejamento editorial, procedimentos e ideias.</p>
        <button type="button" class="mkt-btn" data-mkt-action="refresh">↻ Atualizar leitura</button></div>
      <div class="mkt-tabs" role="group" aria-label="Seções de Marketing">
        <button type="button" class="mkt-btn" data-mkt-tab="calendario">Calendário</button>
        <button type="button" class="mkt-btn" data-mkt-tab="prompts">Prompts</button>
        <button type="button" class="mkt-btn" data-mkt-tab="gaveta">Gaveta</button>
      </div>
      <div id="mkt-panel" aria-busy="false"></div>
      <p class="mkt-notice" id="mkt-notice" role="status" aria-live="polite"></p>
      <dialog class="mkt-dialog" id="mkt-dialog" aria-labelledby="mkt-detail-title">
        <header><h2 id="mkt-detail-title"></h2><button type="button" class="mkt-btn" data-mkt-action="close" aria-label="Fechar detalhes">Fechar ×</button></header>
        <div id="mkt-detail-body"></div><p id="mkt-copy-status" role="status" aria-live="polite"></p>
      </dialog>`;
    root().addEventListener('click', onClick);
    root().addEventListener('change', onFilter);
    root().addEventListener('input', e => { if (e.target.dataset.mktFilter === 'busca') onFilter(e); });
  }

  function request(fn) {
    return new Promise((resolve, reject) => {
      if (typeof google === 'undefined' || !google.script || !google.script.run) {
        reject(new Error('Marketing: abra a cópia de teste no Google Apps Script para ler a planilha oficial.')); return;
      }
      const timer = setTimeout(() => reject(new Error('Marketing: tempo de leitura esgotado. Verifique a conexão e tente novamente.')), 45000);
      google.script.run.withSuccessHandler(value => { clearTimeout(timer); resolve(value); })
        .withFailureHandler(e => { clearTimeout(timer); reject(new Error(e && e.message ? e.message : 'Marketing: falha na leitura.')); })[fn]();
    });
  }

  function load(tab, force) {
    if (S.pending[tab]) return S.pending[tab];
    if (!force && S.cache[tab]) { renderPanel(); return Promise.resolve(); }
    S.errors[tab] = '';
    S.cache[tab] = null;
    // A mesma promessa é reutilizada até a consulta terminar.
    S.pending[tab] = Promise.resolve().then(() => request(functions[tab])).then(data => {
      if (!data || !Array.isArray(data.itens)) throw new Error('Marketing: resposta de leitura inválida.');
      S.cache[tab] = data;
      if (tab === 'calendario' && !data.semanas.some(w => w.inicio === S.week)) S.week = data.semanaInicial;
    }).catch(e => { S.errors[tab] = e.message; }).finally(() => {
      delete S.pending[tab];
      if (S.tab === tab) renderPanel();
    });
    renderPanel();
    return S.pending[tab];
  }

  function selectFilter(key, label, items) {
    const values = Array.from(new Set(items.map(i => i[key]).filter(Boolean))).sort((a, b) => a.localeCompare(b, 'pt-BR'));
    if (!values.includes(S.filters[S.tab][key])) S.filters[S.tab][key] = '';
    return '<label>' + h(label) + '<select data-mkt-filter="' + key + '"><option value="">Todos</option>' + values.map(v =>
      '<option value="' + h(v) + '"' + (S.filters[S.tab][key] === v ? ' selected' : '') + '>' + h(key === 'formato' ? format(v) : v) + '</option>').join('') + '</select></label>';
  }

  function renderPanel() {
    root().dataset.mktSection = S.tab;
    root().querySelectorAll('[data-mkt-tab]').forEach(b => { b.classList.toggle('mkt-active', b.dataset.mktTab === S.tab); b.setAttribute('aria-pressed', b.dataset.mktTab === S.tab ? 'true' : 'false'); });
    const panel = q('#mkt-panel'), refresh = q('[data-mkt-action="refresh"]');
    refresh.disabled = !!S.pending[S.tab];
    panel.setAttribute('aria-busy', S.pending[S.tab] ? 'true' : 'false');
    q('#mkt-notice').textContent = '';
    if (S.pending[S.tab]) { panel.innerHTML = '<p class="mkt-empty" role="status">Lendo a planilha oficial…</p>'; return; }
    if (S.errors[S.tab]) { panel.innerHTML = '<div class="mkt-error" role="alert">' + h(S.errors[S.tab]) + '<br><button type="button" class="mkt-btn" data-mkt-action="refresh">Tentar novamente</button></div>'; return; }
    const data = S.cache[S.tab];
    if (!data) { panel.innerHTML = ''; return; }
    if (S.tab === 'prompts') {
      panel.innerHTML = '<div class="mkt-prompt-flow" aria-label="Sequência dos procedimentos"><strong>P01 <span aria-hidden="true">→</span> P02 <span aria-hidden="true">→</span> P03</strong><span>Pesquisa · Planejamento · Validação</span></div><p class="mkt-note">Copie e utilize no projeto ChatGPT. A pesquisa não é executada por esta página.</p><div class="mkt-library">' + (data.itens.length ? data.itens.map((i, index) => `
        <article class="mkt-card mkt-prompt-card"><p class="mkt-eyebrow">${h(i.id)}</p><h3>${text(i.nome)}</h3><p>${text(i.objetivo)}</p>
          <p><strong>Quando usar:</strong> ${text(i.quando)}</p><div class="mkt-meta">${badge(i.versao ? 'Versão ' + i.versao : 'Sem versão')}${badge(i.status)}</div>
          <p class="mkt-note">Atualizado em: ${text(i.atualizado)}</p><div class="mkt-actions">
            <button type="button" class="mkt-btn" data-mkt-action="detail" data-mkt-index="${index}">Visualizar prompt</button>
            <button type="button" class="mkt-btn mkt-copy-primary" data-mkt-action="copy-prompt" data-mkt-index="${index}" ${i.texto ? '' : 'disabled'}>Copiar prompt</button></div></article>`).join('') : empty('Nenhum prompt oficial ativo encontrado.')) + '</div>';
      const missing = ['P01', 'P02', 'P03'].filter(id => !data.itens.some(i => i.id.trim().toUpperCase() === id));
      if (missing.length) q('#mkt-notice').textContent = 'Prompts oficiais ausentes ou inativos: ' + missing.join(', ') + '.';
      return;
    }
    const filterItems = data.itens;
    panel.innerHTML = (S.tab === 'calendario' ? `
      <div class="mkt-week-nav"><button type="button" class="mkt-btn" data-mkt-action="prev" aria-label="Semana planejada anterior">‹</button>
        <label>Semana planejada<select id="mkt-week">${data.semanas.map(w => '<option value="' + h(w.inicio) + '"' + (w.inicio === S.week ? ' selected' : '') + '>' + dateBr(w.inicio) + ' a ' + dateBr(w.fim) + '</option>').join('')}</select></label>
        <button type="button" class="mkt-btn" data-mkt-action="next" aria-label="Próxima semana planejada">›</button></div>` : '') +
      '<div class="mkt-filters">' + (S.tab === 'gaveta' ? '<label>Buscar ideia<input type="search" data-mkt-filter="busca" placeholder="Pesquisar pelo título" value="' + h(S.filters.gaveta.busca) + '"></label>' : '') +
      selectFilter('formato', 'Formato', filterItems) + (S.tab === 'calendario' ? selectFilter('responsavel', 'Responsável', filterItems) : '') + selectFilter('status', 'Status', filterItems) + '</div><p class="mkt-note" id="mkt-summary" role="status" aria-live="polite"></p><div id="mkt-list"></div>';
    renderList();
  }

  function matches(i) {
    const f = S.filters[S.tab];
    return (!f.formato || i.formato === f.formato) && (!f.status || i.status === f.status) && (!f.responsavel || i.responsavel === f.responsavel) && (!f.busca || norm(i.titulo).includes(norm(f.busca)));
  }

  function calendarCard(i, collection) {
    const data = S.cache.calendario, index = data[collection || 'itens'].indexOf(i);
    const line = norm(i.linhaEditorial);
    return `<button type="button" class="mkt-card mkt-content ${line === 'comercial' ? 'mkt-commercial' : line === 'autoridade' ? 'mkt-authority' : ''}" data-mkt-action="detail" data-mkt-index="${index}" data-mkt-collection="${collection || 'itens'}">
      <span class="mkt-card-top"><span class="mkt-card-period">${text(i.periodo || 'Período não informado')}</span>${badge(i.status)}</span>
      <strong class="mkt-card-title">${text(i.titulo)}</strong><span class="mkt-card-bottom">${badge(format(i.formato))}<span class="mkt-line-label">${text(i.linhaEditorial)}</span><span class="mkt-card-open" aria-hidden="true">Ver detalhes ↗</span></span></button>`;
  }

  function renderList(options) {
    const data = S.cache[S.tab], list = q('#mkt-list');
    if (S.tab === 'gaveta') {
      const items = data.itens.filter(matches);
      q('#mkt-summary').textContent = items.length + ' de ' + data.itens.length + ' ideias';
      list.innerHTML = !data.itens.length ? empty('Nenhuma ideia cadastrada na gaveta. As ideias não selecionadas nas pesquisas poderão ser armazenadas aqui.') : !items.length ? empty('Nenhuma ideia corresponde aos filtros.') : '<div class="mkt-library">' + items.map(i => `
        <article class="mkt-card"><h3>${text(i.titulo)}</h3><div class="mkt-meta">${badge(format(i.formato))}${badge(i.status)}</div>
          <p><b>Canal sugerido:</b> ${text(i.canais)}</p><p><b>Referência:</b> ${text(i.referencia)} ${links(i.referencia)}</p>
          <p><b>Responsável:</b> ${text(i.responsavel)}</p><p><b>Próxima ação:</b> ${text(i.proximaAcao)}</p><p class="mkt-preserve"><b>Observações:</b> ${text(i.observacoes)}</p></article>`).join('') + '</div>';
      return;
    }
    const weekItems = data.itens.filter(i => i.semana === S.week), items = weekItems.filter(matches);
    const completed = weekItems.filter(i => i.concluido).length;
    const counts = { story: 0, reel: 0, google: 0 };
    weekItems.forEach(i => { const f = norm(i.formato); if (['storystatus', 'story', 'stories', 'status'].includes(f)) counts.story++; if (['reel', 'reels'].includes(f)) counts.reel++; if (f === 'google') counts.google++; });
    q('#mkt-summary').textContent = `${weekItems.length} planejados nesta semana · ${completed} concluídos · ${items.length} nos filtros. Stories/Status: ${counts.story} · Reels: ${counts.reel} · Google: ${counts.google}.`;
    q('#mkt-summary').title = 'Concluídos: somente PUBLICADO, CONCLUÍDO ou FINALIZADO e suas formas femininas. Pronto, aprovado e rascunho não contam como concluídos.';
    const wi = data.semanas.findIndex(w => w.inicio === S.week);
    q('[data-mkt-action="prev"]').disabled = wi <= 0;
    q('[data-mkt-action="next"]').disabled = wi < 0 || wi >= data.semanas.length - 1;
    q('#mkt-week').disabled = !data.semanas.length;
    const days = ['Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado', 'Domingo'];
    const shortDays = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
    if (S.week) {
      const firstMatch = items.map(i => i.data).sort()[0];
      if (!S.day || S.day < S.week || S.day > plus(S.week, 6)) S.day = data.hoje >= S.week && data.hoje <= plus(S.week, 6) ? data.hoje : firstMatch || S.week;
      if (options && options.chooseDay && firstMatch && !items.some(i => i.data === S.day)) S.day = firstMatch;
    } else S.day = '';
    const dayItems = items.filter(i => i.data === S.day);
    const periodOrder = { manha: 0, tarde: 1, noite: 2 };
    dayItems.sort((a, b) => (periodOrder[norm(a.periodo)] == null ? 3 : periodOrder[norm(a.periodo)]) - (periodOrder[norm(b.periodo)] == null ? 3 : periodOrder[norm(b.periodo)]));
    const dayIndex = S.week ? Math.round((new Date(S.day + 'T12:00:00Z') - new Date(S.week + 'T12:00:00Z')) / 86400000) : 0;
    list.innerHTML = !S.week ? empty('Nenhuma semana com data válida cadastrada no calendário editorial.') :
      '<div class="mkt-week-overview" role="group" aria-label="Selecione um dia da semana">' + days.map((name, index) => {
        const date = plus(S.week, index), total = weekItems.filter(i => i.data === date).length, visible = items.filter(i => i.data === date).length;
        const count = visible === total ? visible + '<span class="mkt-day-count-label"> ' + (visible === 1 ? 'item' : 'itens') + '</span>' : visible + '/' + total;
        const label = name + ', ' + dateBr(date) + ': ' + visible + ' de ' + total + ' conteúdos nos filtros' + (date === data.hoje ? ', hoje' : '');
        return '<button type="button" class="mkt-day' + (date === data.hoje ? ' mkt-today' : '') + (date === S.day ? ' mkt-day-selected' : '') + '" data-mkt-action="day" data-mkt-date="' + date + '" aria-pressed="' + (date === S.day ? 'true' : 'false') + '" aria-controls="mkt-selected-day" aria-label="' + h(label) + '"' + (date === data.hoje ? ' aria-current="date"' : '') + '><span class="mkt-day-name">' + shortDays[index] + '</span><strong class="mkt-day-date">' + date.slice(8) + '</strong><span class="mkt-day-count">' + count + '</span></button>';
      }).join('') + '</div><div class="mkt-day-help"><span>Selecione um dia para consultar os conteúdos.</span>' + (data.hoje >= S.week && data.hoje <= plus(S.week, 6) ? '<span class="mkt-today-key">Hoje</span>' : '') + '</div>' +
      '<section id="mkt-selected-day" class="mkt-selected-day" aria-labelledby="mkt-day-title"><header class="mkt-selected-head"><div><p class="mkt-eyebrow">CONTEÚDOS DO DIA</p><h2 id="mkt-day-title">' + days[dayIndex] + ' <span>' + dateBr(S.day) + '</span></h2></div><span class="mkt-day-total" role="status" aria-live="polite">' + dayItems.length + ' ' + (dayItems.length === 1 ? 'conteúdo' : 'conteúdos') + '</span></header>' +
      (dayItems.length ? '<div class="mkt-day-cards">' + dayItems.map(i => calendarCard(i)).join('') + '</div>' : empty(items.length ? 'Nenhum conteúdo corresponde aos filtros neste dia. Selecione outro dia da semana.' : 'Nenhum conteúdo corresponde aos filtros nesta semana.')) + '</section>';
    q('#mkt-notice').textContent = data.reservas + ' registros RESERVA fora do calendário e dos indicadores.';
    if (data.semData.length) {
      list.innerHTML += '<details class="mkt-undated"><summary>' + data.semData.length + ' registros sem data válida — fora do calendário e dos indicadores</summary><div class="mkt-library">' + data.semData.filter(matches).map(i => calendarCard(i, 'semData')).join('') + '</div></details>';
    }
  }

  function onFilter(e) {
    if (e.target.id === 'mkt-week') { S.week = e.target.value; renderList(); return; }
    const key = e.target.dataset.mktFilter;
    if (!key || !S.filters[S.tab]) return;
    S.filters[S.tab][key] = e.target.value;
    renderList({ chooseDay: true });
  }

  function field(label, value, refs) {
    return '<section class="mkt-detail-field"><h3>' + h(label) + '</h3><div class="mkt-preserve">' + text(value) + '</div>' + (refs ? links(value) : '') + '</section>';
  }

  function detail(index, collection) {
    const item = S.cache[S.tab][collection || 'itens'][index];
    if (!item) return;
    const prompt = S.tab === 'prompts';
    q('#mkt-detail-title').textContent = prompt ? (item.id + ' — ' + item.nome) : (item.titulo || 'Conteúdo sem título');
    q('#mkt-detail-body').innerHTML = prompt ?
      field('Finalidade', item.objetivo) + field('Quando utilizar', item.quando) + field('Versão / status', [item.versao, item.status].filter(Boolean).join(' · ')) + field('Prompt completo', item.texto) + field('Notas operacionais', item.notas) :
      field('Identificação', item.id) + field('Data / período', [item.data ? dateBr(item.data) : item.dataOriginal, item.periodo].filter(Boolean).join(' · ')) + field('Formato / linha editorial', [format(item.formato), item.linhaEditorial].filter(Boolean).join(' · ')) + field('Canais', item.canais) + field('Responsável', item.responsavel) + field('Público-alvo', item.publico) + field('Objetivo', item.objetivo) + field('Texto / roteiro completo', item.texto) + field('Material necessário', item.midia) + field('Instruções de gravação e edição', item.edicao) + field('Referências, vínculos e observações', item.observacoes, true) + field('Status', item.status) + field('Próxima ação', item.proximaAcao);
    const copy = document.createElement('button');
    copy.type = 'button'; copy.className = 'mkt-btn'; copy.textContent = prompt ? 'Copiar prompt' : 'Copiar texto / roteiro'; copy.disabled = !item.texto;
    copy.addEventListener('click', () => copyText(item.texto));
    q('#mkt-detail-body').prepend(copy);
    q('#mkt-copy-status').textContent = '';
    q('#mkt-dialog').showModal();
    q('#mkt-detail-body').scrollTop = 0;
  }

  async function copyText(value) {
    const message = q('#mkt-dialog').open ? q('#mkt-copy-status') : q('#mkt-notice');
    try {
      let copied = false;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        try { await navigator.clipboard.writeText(value); copied = true; } catch (_) { /* Usar seleção compatível com iframe. */ }
      }
      if (!copied) {
        const area = document.createElement('textarea'), previous = document.activeElement;
        area.value = value; area.className = 'mkt-copy-buffer'; area.setAttribute('aria-label', 'Texto para copiar');
        (q('#mkt-dialog').open ? q('#mkt-dialog') : root()).appendChild(area);
        area.focus(); area.select();
        try { copied = document.execCommand('copy'); } finally { area.remove(); if (previous) previous.focus(); }
      }
      if (!copied) throw new Error('Cópia indisponível');
      message.textContent = 'Texto integral copiado.';
    } catch (_) { message.textContent = 'O navegador bloqueou a cópia. Abra os detalhes e selecione o texto integral para copiar manualmente.'; }
  }

  function onClick(e) {
    const button = e.target.closest('[data-mkt-tab], [data-mkt-action]');
    if (!button || !root().contains(button)) return;
    if (button.dataset.mktTab) { S.tab = button.dataset.mktTab; load(S.tab, false); return; }
    const action = button.dataset.mktAction;
    if (action === 'refresh') load(S.tab, true);
    if (action === 'close') q('#mkt-dialog').close();
    if (action === 'detail') detail(Number(button.dataset.mktIndex), button.dataset.mktCollection);
    if (action === 'day') {
      S.day = button.dataset.mktDate;
      renderList();
      const selected = q('[data-mkt-date="' + S.day + '"]');
      if (selected) selected.focus({ preventScroll: true });
    }
    if (action === 'copy-prompt') copyText(S.cache.prompts.itens[Number(button.dataset.mktIndex)].texto);
    if (action === 'prev' || action === 'next') {
      const weeks = S.cache.calendario.semanas, index = weeks.findIndex(w => w.inicio === S.week) + (action === 'prev' ? -1 : 1);
      if (weeks[index]) { S.week = weeks[index].inicio; q('#mkt-week').value = S.week; renderList(); }
    }
  }

  window.FausMarketing = Object.freeze({ open: () => { init(); return load(S.tab, true); }, refresh: () => { init(); return load(S.tab, true); } });
}());
</script>
<!-- FAUS MARKETING: END JS -->
</body>

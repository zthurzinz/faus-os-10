<!doctype html>
<html lang="pt-BR">
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0d2019">
  <meta name="faus-afazeres-build" content="teste-v2.1.4">
  <title>FAUS OS</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
  
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="">

  <style>
    :root {
      --forest: #0d2019;
      --forest-light: #16362a;
      --forest-border: #224b3b;
      --green: #1b6343;
      --green-2: #2a835a;
      --mint: #e1f4ea;
      --mint-text: #135639;
      --lime: #caeb88;
      --gold: #d89f36;
      --gold-bg: #fdf5e7;
      --bg: #f5f4ef;
      --surface: #ffffff;
      --surface-subtle: #f8faf8;
      --line: #e1e6e0;
      --line-subtle: #edf1ec;
      --ink: #14231c;
      --ink-subtle: #45554d;
      --muted: #6e7d75;
      --danger: #b3362a;
      --danger-bg: #faeae8;
      --danger-border: #f2c7c2;
      --radius: 14px;
      --radius-sm: 9px;
      --shadow: 0 10px 30px rgba(13, 32, 25, 0.05);
      --shadow-sm: 0 4px 12px rgba(13, 32, 25, 0.04);
      --shadow-lg: 0 20px 45px rgba(13, 32, 25, 0.12);
      font-family: 'Manrope', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--ink);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }

    * { box-sizing: border-box; }
    html { background: var(--forest); }
    body { margin: 0; background: var(--bg); min-height: 100vh; overflow-x: hidden; }
    button, input, select, textarea { font: inherit; color: inherit; }
    button { border: 0; cursor: pointer; transition: all 0.18s ease; }
    
     
    .app-shell { min-height: 100vh; display: grid; grid-template-columns: 248px minmax(0, 1fr); }
    
     
    .sidebar {
      position: sticky; top: 0; height: 100vh;
      background: var(--forest); color: #fff;
      padding: 24px 16px; display: flex; flex-direction: column;
      z-index: 50; border-right: 1px solid rgba(255,255,255,0.06);
    }
    .brand {
      display: flex; align-items: center; gap: 12px;
      padding: 0 8px; margin-bottom: 30px;
    }
    .brand-mark {
      width: 40px; height: 40px; border-radius: 11px;
      background: linear-gradient(135deg, #dcf89d, #9ed259);
      color: var(--forest); display: grid; place-items: center;
      font-size: 21px; font-weight: 900;
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }
    .brand-copy strong { display: block; font-size: 17px; letter-spacing: 0.12em; line-height: 1.1; }
    .brand-copy small { font-size: 9px; color: #8faea1; letter-spacing: 0.1em; text-transform: uppercase; }
    
    .nav-caption {
      padding: 0 12px; margin-bottom: 7px;
      color: #6d8e80; font-size: 9px; font-weight: 800; letter-spacing: 0.14em;
    }
    .primary-nav { display: grid; gap: 4px; }
    .nav {
      display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 10px;
      width: 100%; padding: 10px 12px; border-radius: 10px;
      background: transparent; color: #a9beba; text-align: left;
      font-weight: 600; font-size: 13px; position: relative;
    }
    .nav:hover { background: rgba(255,255,255,0.06); color: #fff; }
    .nav.active { background: rgba(255,255,255,0.12); color: #fff; font-weight: 700; }
    .nav.active::before {
      content: ""; position: absolute; left: -16px; top: 8px; bottom: 8px; width: 4px;
      border-radius: 0 4px 4px 0; background: var(--lime);
    }
    .nav-icon {
      display: grid; place-items: center; width: 26px; height: 26px;
      border-radius: 7px; background: rgba(255,255,255,0.06); font-size: 13px;
    }
    .nav.active .nav-icon { background: var(--lime); color: var(--forest); }
    .nav b {
      font-size: 8px; text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--forest); background: var(--lime); padding: 2px 6px; border-radius: 99px;
    }
    
    .owner-card {
      margin-top: auto; display: grid; grid-template-columns: 34px 1fr 8px; gap: 10px;
      align-items: center; padding: 11px; border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.04); border-radius: 12px;
    }
    .owner-avatar {
      width: 34px; height: 34px; display: grid; place-items: center;
      border-radius: 9px; background: #214436; color: #d6e9df; font-size: 11px; font-weight: 800;
    }
    .owner-card strong { display: block; font-size: 11px; color: #fff; }
    .owner-card small { font-size: 9px; color: #839c90; }
    .status-dot {
      width: 8px; height: 8px; border-radius: 50%; background: #6fe398;
      box-shadow: 0 0 0 3px rgba(111,227,152,0.18);
    }
    .sidebar-meta {
      display: flex; justify-content: space-between; padding: 11px 4px 0;
      color: #5d7a6e; font-size: 9px;
    }

     
    .main {
      min-width: 0; padding: 26px 34px 60px; max-width: 1560px; width: 100%; margin: 0 auto;
    }
    .topbar {
      display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px;
    }
    .page-title h1 { margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; color: var(--ink); }
    .eyebrow {
      margin: 0 0 4px; color: var(--muted); font-size: 9px; font-weight: 800;
      letter-spacing: 0.14em; text-transform: uppercase;
    }
    .top-actions { display: flex; align-items: center; gap: 8px; }
    .today-pill {
      display: flex; align-items: center; gap: 8px; background: var(--surface);
      border: 1px solid var(--line); border-radius: 9px; padding: 8px 12px;
      color: var(--ink-subtle); font-size: 11px; font-weight: 700; box-shadow: var(--shadow-sm);
    }
    .icon-button {
      height: 36px; width: 36px; border-radius: 9px; background: var(--surface);
      border: 1px solid var(--line); color: var(--forest); display: grid; place-items: center;
      font-size: 16px; box-shadow: var(--shadow-sm);
    }
    .icon-button:hover { background: #f0f3ef; }
    
    .primary-btn {
      background: var(--forest); color: #fff; border-radius: 9px;
      padding: 9px 15px; font-weight: 700; font-size: 12px;
      display: inline-flex; align-items: center; gap: 7px;
      box-shadow: 0 4px 14px rgba(13,32,25,0.15);
    }
    .primary-btn:hover { background: var(--forest-light); transform: translateY(-1px); }
    .primary-btn.full { width: 100%; justify-content: center; padding: 11px; }
    .primary-btn.lime { background: var(--lime); color: var(--forest); font-weight: 800; }
    .primary-btn.lime:hover { background: #d7f59d; }

    .secondary-btn {
      background: var(--surface); color: var(--forest); border: 1px solid var(--line);
      border-radius: 9px; padding: 8px 14px; font-weight: 700; font-size: 11px;
      display: inline-flex; align-items: center; gap: 7px;
    }
    .secondary-btn:hover { background: #f0f4f0; }
    .secondary-btn.full { width: 100%; justify-content: center; }

    .text-button {
      background: transparent; color: var(--green); font-size: 11px;
      font-weight: 800; padding: 4px 6px; border-radius: 6px;
    }
    .text-button:hover { background: var(--mint); }

     
    .view { display: none; animation: fadeIn 0.2s ease; }
    .view.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }

     
    .hero-banner {
      background: linear-gradient(130deg, #0d2019 0%, #16382b 60%, #1e4d3b 100%);
      color: #fff; border-radius: 16px; padding: 22px 28px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 20px; margin-bottom: 18px; box-shadow: var(--shadow);
      position: relative; overflow: hidden;
    }
    .hero-banner::after {
      content: ""; position: absolute; right: -40px; top: -60px; width: 220px; height: 220px;
      border-radius: 50%; background: radial-gradient(circle, rgba(202,235,136,0.14), transparent 70%);
      pointer-events: none;
    }
    .hero-text h2 { margin: 4px 0 6px; font-size: 22px; font-weight: 800; letter-spacing: -0.03em; }
    .hero-text p { margin: 0; color: #b7d1c6; font-size: 12px; max-width: 580px; line-height: 1.5; }
    .hero-actions { display: flex; align-items: center; gap: 10px; z-index: 2; flex-shrink: 0; }

     
    .kpi-grid {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px; margin-bottom: 18px;
    }
    .kpi-card {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius); padding: 15px 18px;
      box-shadow: var(--shadow-sm); position: relative;
    }
    .kpi-header { display: flex; justify-content: space-between; align-items: center; }
    .kpi-label { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
    .kpi-icon {
      width: 24px; height: 24px; border-radius: 7px;
      background: var(--surface-subtle); color: var(--green);
      display: grid; place-items: center; font-size: 11px; font-weight: 800;
    }
    .kpi-value {
      font-size: 22px; font-weight: 800; letter-spacing: -0.04em;
      margin: 9px 0 3px; color: var(--ink); line-height: 1.1;
    }
    .kpi-sub { font-size: 10px; color: var(--muted); display: flex; align-items: center; gap: 5px; }
    .kpi-badge {
      display: inline-block; padding: 2px 6px; border-radius: 99px;
      font-size: 8px; font-weight: 800; text-transform: uppercase;
    }
    .kpi-badge.positive { background: var(--mint); color: var(--mint-text); }
    .kpi-badge.negative { background: var(--danger-bg); color: var(--danger); }
    .kpi-badge.alert { background: var(--gold-bg); color: var(--gold); }
    .kpi-card.alert-card { border-color: var(--danger-border); }
    .kpi-card.alert-card .kpi-icon { background: var(--danger-bg); color: var(--danger); }
    .kpi-card.alert-card .kpi-value { color: var(--danger); }

     
    .dashboard-grid {
      display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(310px, 0.55fr);
      gap: 16px; align-items: start;
    }
    .panel {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius); padding: 18px 20px;
      box-shadow: var(--shadow-sm);
    }
    .panel-head {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 14px; gap: 10px;
    }
    .panel-head h2 { margin: 0; font-size: 16px; font-weight: 800; letter-spacing: -0.02em; }
    
     
    .week-card-summary {
      background: var(--surface-subtle); border: 1px solid var(--line);
      border-radius: 12px; padding: 12px 15px; margin-bottom: 14px;
    }
    .week-card-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 8px;
    }
    .week-card-header strong { font-size: 13px; font-weight: 800; color: var(--ink); }
    .week-progress-bar {
      height: 6px; background: #e5eae5; border-radius: 99px; overflow: hidden;
    }
    .week-progress-bar span {
      display: block; height: 100%; background: var(--green-2); border-radius: 99px;
      transition: width 0.3s ease;
    }
    .week-metas-wrap { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; }
    .week-meta-tag {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: 6px; padding: 4px 8px; font-size: 10px;
      color: var(--ink-subtle); font-weight: 600; display: flex; align-items: center; gap: 5px;
    }
    .week-meta-tag::before {
      content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--lime);
    }

     
    .task-list { display: grid; gap: 6px; }
    .category-group { margin-bottom: 10px; }
    .category-title {
      font-size: 10px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--muted); margin: 0 0 6px 4px;
    }
    .task-row {
      display: grid; grid-template-columns: 28px 1fr;
      align-items: center; gap: 10px; padding: 8px 10px;
      border: 1px solid var(--line-subtle); border-radius: 9px;
      background: var(--surface); transition: background 0.15s ease;
    }
    .task-row:hover { background: #f9fbf9; border-color: var(--line); }
    .task-row.done { opacity: 0.6; }
    .task-row.done strong { text-decoration: line-through; color: var(--muted); }
    
    .task-checkbox {
      width: 22px; height: 22px; border-radius: 6px;
      border: 1.5px solid #bdc9c0; background: #fff;
      display: grid; place-items: center; font-size: 13px; font-weight: 900;
      color: transparent; transition: all 0.15s ease; flex-shrink: 0;
    }
    .task-checkbox:hover { border-color: var(--green); }
    .task-checkbox.checked {
      background: var(--green); border-color: var(--green); color: #fff;
    }
    .task-title { font-size: 11px; font-weight: 600; color: var(--ink); line-height: 1.3; }

     
    .pulse-stack { display: grid; gap: 2px; }
    .pulse-item {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 0; border-bottom: 1px solid var(--line-subtle);
    }
    .pulse-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .pulse-item span { color: var(--muted); font-size: 11px; }
    .pulse-item strong { font-size: 14px; font-weight: 700; }
    
     
    .machines-mini-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .machine-mini-card {
      display: flex; align-items: center; gap: 10px; padding: 10px;
      border: 1px solid var(--line); border-radius: 10px; background: var(--surface-subtle);
    }
    .machine-mini-icon {
      width: 34px; height: 34px; border-radius: 8px; background: var(--mint);
      color: var(--green); display: grid; place-items: center; font-size: 14px; flex-shrink: 0;
    }
    .machine-mini-info strong { display: block; font-size: 11px; font-weight: 700; }
    .machine-mini-info small { font-size: 9px; color: var(--muted); }

     
    .section-intro {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 16px; margin-bottom: 20px;
    }
    .section-intro h2 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.03em; }
    .section-intro p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
    .section-tag {
      display: inline-block; color: var(--green); background: var(--mint);
      border-radius: 99px; padding: 4px 9px; font-size: 8px; font-weight: 800;
      letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px;
    }

     
    .map-layout {
      display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 16px;
      align-items: start;
    }
    .map-panel { max-height: calc(100vh - 160px); overflow-y: auto; }
    .map-canvas-container {
      position: relative; height: calc(100vh - 160px); min-height: 560px;
      border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line);
      box-shadow: var(--shadow); background: #e5ece6;
    }
    #map { width: 100%; height: 100%; z-index: 10; }
    
    .map-legend {
      position: absolute; left: 16px; bottom: 16px; z-index: 500;
      background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(8px);
      padding: 7px 12px; border-radius: 99px; border: 1px solid var(--line);
      box-shadow: var(--shadow-sm); display: flex; gap: 12px; font-size: 9px; font-weight: 700;
    }
    .legend-item { display: flex; align-items: center; gap: 5px; }
    .legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .legend-dot.obra { background: #0d2019; }
    .legend-dot.cliente { background: #1b6343; }
    .legend-dot.prospect { background: #d89f36; }

    .map-empty-state {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; background: #f0f4f1;
      color: var(--ink-subtle); padding: 20px; text-align: center; z-index: 5;
    }

     
    .form { display: grid; gap: 11px; }
    .form label { display: grid; gap: 4px; color: var(--ink-subtle); font-size: 10px; font-weight: 700; }
    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    input, select, textarea {
      width: 100%; border: 1px solid var(--line); border-radius: 8px;
      padding: 9px 11px; background: #fff; color: var(--ink);
      font-size: 11px; outline: none; transition: border-color 0.15s ease;
    }
    input:focus, select:focus, textarea:focus {
      border-color: var(--green); box-shadow: 0 0 0 3px rgba(27,99,67,0.1);
    }
    textarea { resize: vertical; }

     
    .table-panel { margin-top: 16px; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 720px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); font-size: 11px; }
    th { font-size: 9px; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
    td strong { display: block; font-size: 11px; font-weight: 700; }
    td span { color: var(--muted); font-size: 9px; }
    
    .badge {
      display: inline-block; padding: 3px 7px; border-radius: 99px;
      font-size: 8px; font-weight: 800; text-transform: uppercase;
      background: var(--surface-subtle); color: var(--ink-subtle);
    }
    .badge.green { background: var(--mint); color: var(--mint-text); }
    .badge.danger { background: var(--danger-bg); color: var(--danger); }
    .badge.gold { background: var(--gold-bg); color: var(--gold); }

     
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(13,32,25,0.45);
      backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center;
      z-index: 2000; padding: 16px;
    }
    .modal-backdrop.show { display: flex; }
    .modal-card {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: 16px; box-shadow: var(--shadow-lg);
      width: min(720px, 100%); max-height: min(85vh, 740px); overflow-y: auto;
      padding: 22px;
    }
    .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .modal-head h2 { margin: 0; font-size: 18px; font-weight: 800; }

     
    .planner-row { display: grid; grid-template-columns: 24px 1fr 28px; gap: 8px; align-items: center; margin-bottom: 6px; }
    .planner-remove {
      width: 28px; height: 28px; border-radius: 6px; background: var(--danger-bg);
      color: var(--danger); font-size: 14px; font-weight: 800; display: grid; place-items: center;
    }

     
    .drive-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px;
    }
    .drive-card {
      background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
      padding: 14px; display: flex; align-items: center; justify-content: space-between;
      gap: 12px; box-shadow: var(--shadow-sm); text-decoration: none; color: inherit;
      transition: all 0.15s ease;
    }
    .drive-card:hover { transform: translateY(-2px); border-color: var(--green); box-shadow: var(--shadow); }
    .drive-card-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .drive-card-icon {
      width: 38px; height: 38px; border-radius: 9px; background: var(--surface-subtle);
      display: grid; place-items: center; font-size: 18px; flex-shrink: 0;
    }
    .drive-card-info strong { display: block; font-size: 11px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .drive-card-info small { font-size: 9px; color: var(--muted); }

     
    .direction-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .direction-card {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius); padding: 16px; margin-bottom: 10px;
    }
    .direction-card h3 { margin: 0 0 6px; font-size: 13px; font-weight: 800; color: var(--ink); }
    .direction-card p { margin: 0 0 8px; font-size: 11px; color: var(--ink-subtle); line-height: 1.5; }
    .direction-card ul { margin: 0; padding-left: 16px; font-size: 11px; color: var(--ink-subtle); }
    .direction-card li { margin-bottom: 4px; }

     
    .toast {
      position: fixed; top: 20px; right: 20px; z-index: 3000;
      background: var(--forest); color: #fff; padding: 11px 16px;
      border-radius: 9px; font-size: 11px; font-weight: 700;
      box-shadow: var(--shadow-lg); transform: translateY(-80px); opacity: 0;
      transition: all 0.25s ease; pointer-events: none;
    }
    .toast.show { transform: none; opacity: 1; pointer-events: auto; }
    .toast.error { background: var(--danger); }

     
    .loading-pill {
      display: none; align-items: center; gap: 8px; padding: 8px 12px;
      background: var(--surface); border: 1px solid var(--line);
      border-radius: 99px; margin-bottom: 14px; font-size: 11px; font-weight: 700;
    }
    .loading-pill.show { display: inline-flex; }
    .spinner {
      width: 14px; height: 14px; border: 2px solid #ccd6cf;
      border-top-color: var(--green); border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

     
    .empty-state {
      padding: 24px; text-align: center; color: var(--muted);
      border: 1px dashed var(--line); border-radius: 12px; font-size: 11px;
    }

    .afazeres-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) 380px; gap: 16px; align-items: start; }
    .afazeres-hero {
      background: linear-gradient(150deg, rgba(13,32,25,0.96), rgba(34,75,59,0.92));

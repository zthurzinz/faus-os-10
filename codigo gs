function garantirEstrutura_() {
  Object.keys(ESQUEMAS).forEach(n => {
    const s = aba_(n);
    const esp = ESQUEMAS[n];
    const atuais = headers_(s).filter(String);
    const faltantes = esp.filter(c => !atuais.includes(c));
    if (faltantes.length) {
      s.getRange(1, atuais.length + 1, 1, faltantes.length).setValues([faltantes]);
    }
  });
}



}


function fausFinanceiroRegistrarAba_(tipo, s) {
  if (!s) return;
  const item = {
    tipo: tipo,
    nome: s.getName(),
    gid: s.getSheetId(),
    linhas: s.getLastRow()
  };
  const chave = tipo + ':' + item.gid;
  if (!FAUS_FINANCEIRO_STATUS.abas.some(x => (x.tipo + ':' + x.gid) === chave)) {
    FAUS_FINANCEIRO_STATUS.abas.push(item);
  }
}


function fausFinanceiroNomesAba_(tipo) {
  const cfg = FAUS_FINANCEIRO.abas && FAUS_FINANCEIRO.abas[tipo];
  const nomes = tipo === 'contas' ? [
    cfg,
    'Financeiro_Contas_a_Pagar',
    'CONTAS_A_PAGAR',
    'Contas_a_Pagar',
    'Contas a Pagar',
    'Contas para Pagar',
    'A Pagar'
  ] : [
    cfg,
    'Financeiro_Lancamentos',
    'Financeiro_Lançamentos',
    'LANCAMENTOS',
    'Lançamentos',
    'Lancamentos',
    'FINANCEIRO',
    'Financeiro'
  ];
  const vistos = {};
  return nomes.filter(n => {
    const chave = fausFinanceiroChave_(n);
    if (!chave || vistos[chave]) return false;
    vistos[chave] = true;
    return true;
  });
}


function fausFinanceiroPontuarAba_(s, tipo) {
  try {
    if (!s || s.getLastColumn() < 1) return 0;
    const nome = fausFinanceiroChave_(s.getName());
    const h = headers_(s);
    const mapa = fausFinanceiroMapaHeaders_(h);
    let pontos = 0;
    if (mapa.Valor !== undefined) pontos += 4;
    if (mapa.Descricao !== undefined) pontos += 2;
    if (mapa.Vencimento !== undefined || mapa.Competencia !== undefined || mapa.Mes !== undefined) pontos += 2;
    if (mapa.Situacao !== undefined || mapa.DataPagamento !== undefined) pontos += 1;
    if (tipo === 'contas') {
      if (nome.indexOf('pagar') >= 0 || nome.indexOf('conta') >= 0) pontos += 4;
      else pontos = 0;
    } else if (nome.indexOf('financeiro') >= 0 || nome.indexOf('lancamento') >= 0) {
      pontos += 2;
    }
    return pontos;
  } catch (e) {
    return 0;
  }
}


function fausFinanceiroLinhasDados_(s) {
  try {
    return s ? Math.max(0, s.getLastRow() - 1) : 0;
  } catch (e) {
    return 0;
  }
}


function fausFinanceiroAdicionarCandidato_(lista, vistos, s, tipo, bonus) {
  if (!s) return;
  const gid = String(s.getSheetId());
  if (vistos[gid]) return;
  vistos[gid] = true;
  const pontos = fausFinanceiroPontuarAba_(s, tipo) + (bonus || 0);
  const linhas = fausFinanceiroLinhasDados_(s);
  if (pontos >= 6 || bonus) {
    lista.push({ s: s, pontos: pontos, linhas: linhas });
  }
}


function fausFinanceiroCandidatosAba_(ss, tipo) {
  const candidatos = [];
  const vistos = {};
  const nomes = fausFinanceiroNomesAba_(tipo);

  nomes.forEach(nome => {
    const s = ss.getSheetByName(nome);
    if (s) fausFinanceiroAdicionarCandidato_(candidatos, vistos, s, tipo, 4);
  });

  const gid = FAUS_FINANCEIRO.gids && FAUS_FINANCEIRO.gids[tipo];
  if (gid) {
    const porGid = ss.getSheets().find(x => Number(x.getSheetId()) === Number(gid)) || null;
    if (porGid) fausFinanceiroAdicionarCandidato_(candidatos, vistos, porGid, tipo, 3);
  }

  ss.getSheets().forEach(s => fausFinanceiroAdicionarCandidato_(candidatos, vistos, s, tipo, 0));

  return candidatos.sort((a, b) => {
    const aTemDados = a.linhas > 0 ? 1 : 0;
    const bTemDados = b.linhas > 0 ? 1 : 0;
    if (aTemDados !== bTemDados) return bTemDados - aTemDados;
    if (a.pontos !== b.pontos) return b.pontos - a.pontos;
    return b.linhas - a.linhas;
  });
}


function fausFinanceiroLocalizarAbaNoSs_(ss, tipo, criarSeAusente) {
  if (!ss) return null;
  const melhor = fausFinanceiroCandidatosAba_(ss, tipo)[0];
  if (melhor) return melhor.s;

  if (criarSeAusente && FAUS_FINANCEIRO.abas && FAUS_FINANCEIRO.abas[tipo]) {
    const s = ss.insertSheet(FAUS_FINANCEIRO.abas[tipo]);
    s.getRange(1, 1, 1, ESQUEMAS.FINANCEIRO.length).setValues([ESQUEMAS.FINANCEIRO]);
    return s;
  }
  return null;
}


function fausFinanceiroSs_() {
  const candidatos = [];
  try {
    if (FAUS_FINANCEIRO.spreadsheetId) {
      const configurada = SpreadsheetApp.openById(FAUS_FINANCEIRO.spreadsheetId);
      if (configurada) candidatos.push(configurada);
    }
  } catch (e) {
    fausFinanceiroStatusErro_('Não foi possível abrir a planilha financeira configurada por ID.', { erro: e.message });

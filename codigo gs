function fausDashboardCacheAba_(criar) {
  const ss = ss_();
  let s = ss.getSheetByName(FAUS_DASHBOARD_CACHE.aba);
  if (!s && criar) {
    s = ss.insertSheet(FAUS_DASHBOARD_CACHE.aba);
    s.getRange(1, 1, 1, 2).setValues([['Chave', 'Valor']]);
    s.setFrozenRows(1);
  }
  return s;
}


function fausDashboardCacheSalvar_(payload) {
  const s = fausDashboardCacheAba_(true);
  const atualizadoEm = Utilities.formatDate(new Date(), FAUS.timezone, 'yyyy-MM-dd HH:mm:ss');
  const json = JSON.stringify(serial_(payload));
  const rows = [
    ['Chave', 'Valor'],
    ['AtualizadoEm', atualizadoEm],
    ['Versao', FAUS.versao],
    ['Bytes', json.length]
  ];
  for (let i = 0; i < json.length; i += FAUS_DASHBOARD_CACHE.chunkSize) {
    const parte = Math.floor(i / FAUS_DASHBOARD_CACHE.chunkSize) + 1;
    rows.push(['PayloadJson_' + ('000' + parte).slice(-3), json.slice(i, i + FAUS_DASHBOARD_CACHE.chunkSize)]);
  }
  s.clearContents();
  s.getRange(1, 1, rows.length, 2).setValues(rows);
  try {
    if (json.length < 90000) {
      CacheService.getScriptCache().put(FAUS_DASHBOARD_CACHE.cacheKey, json, FAUS_DASHBOARD_CACHE.ttlSegundos);
    }
  } catch (e) {}
  return { atualizadoEm: atualizadoEm, bytes: json.length, partes: rows.length - 4 };
}


function fausDashboardCacheLer_() {
  try {
    const cached = CacheService.getScriptCache().get(FAUS_DASHBOARD_CACHE.cacheKey);
    if (cached) return JSON.parse(cached);
  } catch (e) {}

  try {
    const s = fausDashboardCacheAba_(false);
    if (!s || s.getLastRow() < 2) return null;
    const rows = s.getRange(2, 1, s.getLastRow() - 1, 2).getDisplayValues();
    const partes = rows
      .filter(r => /^PayloadJson_\d+$/.test(String(r[0] || '')))
      .sort((a, b) => String(a[0]).localeCompare(String(b[0])))
      .map(r => r[1] || '');
    if (!partes.length) return null;
    const json = partes.join('');
    if (json.length < 90000) {
      try {
        CacheService.getScriptCache().put(FAUS_DASHBOARD_CACHE.cacheKey, json, FAUS_DASHBOARD_CACHE.ttlSegundos);
      } catch (e) {}
    }
    return JSON.parse(json);
  } catch (e) {
    fausLog_('dashboard cache leitura falhou', { erro: e.message });
    return null;
  }
}


function fausAtualizarDashboardCache() {

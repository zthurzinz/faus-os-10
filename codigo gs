  const escolhida = candidatos.find(ss =>
    fausFinanceiroLocalizarAbaNoSs_(ss, 'lancamentos', false) ||
    fausFinanceiroLocalizarAbaNoSs_(ss, 'contas', false)
  ) || candidatos[0];

  if (!escolhida) throw new Error('Não foi possível abrir a planilha financeira.');
  fausFinanceiroRegistrarPlanilha_(escolhida);
  return escolhida;
}


function fausFinanceiroAba_(tipo, criarSeAusente) {
  const ss = fausFinanceiroSs_();

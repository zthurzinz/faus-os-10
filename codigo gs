function lock_(fn) {
  const l = LockService.getScriptLock();
  try {
    l.waitLock(10000);
  } catch (e) {}
  try {
    return fn();
  } finally {
    try {
      l.releaseLock();
    } catch (e) {}
  }
}


function auditar_(origem, acao, ent, id, resumo, dados) {
  try {
    if (ent === FAUS.abas.historico) return;
    aba_(FAUS.abas.historico).appendRow([
      id_(),
      agora_(),
      Session.getActiveUser().getEmail() || 'proprietario',
      origem,
      acao,
      ent,
      id,
      seguro_(resumo || ''),
      JSON.stringify(serial_(dados || {})).slice(0, 45000)
    ]);
  } catch (e) {}
}


function inserir_(nome, dados, origem) {
  return lock_(() => {
    const s = aba_(nome);
    const h = headers_(s);
    const r = Object.assign({}, dados);
    const a = agora_();
    if (h.includes('ID') && !r.ID) r.ID = id_();
    if (h.includes('Ativo') && !r.Ativo) r.Ativo = 'Sim';
    if (h.includes('CriadoEm') && !r.CriadoEm) r.CriadoEm = a;
    if (h.includes('AtualizadoEm')) r.AtualizadoEm = a;
    s.appendRow(h.map(k => typeof r[k] === 'string' ? seguro_(r[k]) : (r[k] === undefined ? '' : r[k])));
    auditar_(origem || 'APP', 'CRIAR', nome, r.ID || '', r.Titulo || r.Nome || r.Descricao || '', r);
    return serial_(r);
  });
}


function atualizar_(nome, id, alt) {
  return lock_(() => {
    const s = aba_(nome);
    const h = headers_(s);
    const c = h.indexOf('ID');
    if (c < 0) return { ok: false };
    const ids = s.getRange(2, c + 1, Math.max(s.getLastRow() - 1, 1), 1).getDisplayValues();
    let lin = -1;
    ids.some((x, i) => {
      if (String(x[0]) === String(id)) {
        lin = i + 2;
        return true;
      }
      return false;
    });
    if (lin < 0) throw new Error('Registro não encontrado.');
    const row = s.getRange(lin, 1, 1, h.length).getValues()[0];
    h.forEach((k, i) => {
      if (Object.prototype.hasOwnProperty.call(alt, k)) {
        row[i] = typeof alt[k] === 'string' ? seguro_(alt[k]) : alt[k];
      }
      if (k === 'AtualizadoEm') row[i] = agora_();
    });
    s.getRange(lin, 1, 1, h.length).setValues([row]);
    auditar_('APP', 'ATUALIZAR', nome, id, JSON.stringify(alt), alt);
    return { ok: true, id: id };
  });
}



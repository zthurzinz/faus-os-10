function ss_() {
  try {
    const ativa = SpreadsheetApp.getActiveSpreadsheet();
    if (ativa) return ativa;
  } catch (e) {}
  try {
    if (FAUS_FINANCEIRO.spreadsheetId) {
      return SpreadsheetApp.openById(FAUS_FINANCEIRO.spreadsheetId);
    }
  } catch (e) {}
  throw new Error('Não foi possível abrir a planilha do FAUS OS. Confira se o script está vinculado à planilha correta.');
}


function aba_(n) {
  const ss = ss_();
  let s = ss.getSheetByName(n);
  if (!s) {
    s = ss.insertSheet(n);
    const esp = ESQUEMAS[n] || ['ID', 'CriadoEm'];
    s.getRange(1, 1, 1, esp.length).setValues([esp]);
  }
  return s;
}


function agora_() {
  return new Date();
}


function id_() {
  return Utilities.getUuid();
}


function hoje_() {
  return Utilities.formatDate(new Date(), FAUS.timezone, 'yyyy-MM-dd');
}


function seguro_(v) {
  if (v === null || v === undefined) return '';
  const s = String(v).trim();
  return /^[=+\-@]/.test(s) ? "'" + s : s;
}


function numero_(v) {
  if (typeof v === 'number') return v;
  const n = Number(String(v || '').replace(/\s/g, '').replace(/\./g, '').replace(',', '.'));
  return Number.isFinite(n) ? n : 0;
}


function data_(v) {
  if (!v) return '';
  if (Object.prototype.toString.call(v) === '[object Date]') {
    return Utilities.formatDate(v, FAUS.timezone, 'yyyy-MM-dd');
  }
  return String(v).slice(0, 10);
}


function headers_(s) {
  if (!s || s.getLastColumn() === 0) return [];
  return s.getRange(1, 1, 1, s.getLastColumn()).getDisplayValues()[0];
}


function objetos_(n) {
  try {
    const s = aba_(n);
    if (!s || s.getLastRow() < 2) return [];
    const h = headers_(s);
    if (!h.length) return [];
    const r = s.getRange(2, 1, s.getLastRow() - 1, h.length).getValues();
    return r.map((x, i) => {
      const o = { _linha: i + 2 };
      h.forEach((k, j) => {
        o[k] = Object.prototype.toString.call(x[j]) === '[object Date]' ? data_(x[j]) : x[j];
      });
      return o;
    }).filter(o => {
      if (!Object.prototype.hasOwnProperty.call(o, 'Ativo')) return true;
      const ativo = String(o.Ativo).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      return ativo !== 'nao';
    });
  } catch (e) {
    return [];
  }
}


function objetosLimite_(n, limite) {
  try {
    const s = aba_(n);
    if (!s || s.getLastRow() < 2) return [];
    const h = headers_(s);
    if (!h.length) return [];
    const total = s.getLastRow() - 1;
    const qtd = Math.min(total, Math.max(1, Number(limite || total)));
    const inicio = 2 + (total - qtd);
    const r = s.getRange(inicio, 1, qtd, h.length).getValues();
    return r.map((x, i) => {
      const o = { _linha: inicio + i };
      h.forEach((k, j) => {
        o[k] = Object.prototype.toString.call(x[j]) === '[object Date]' ? data_(x[j]) : x[j];
      });
      return o;
    }).filter(o => {
      if (!Object.prototype.hasOwnProperty.call(o, 'Ativo')) return true;
      const ativo = String(o.Ativo).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      return ativo !== 'nao';
    });
  } catch (e) {
    fausLog_('objetosLimite falhou', { aba: n, erro: e.message });
    return [];
  }
}



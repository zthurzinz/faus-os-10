function resumo_(ops, fin) {
  const hj = hoje_();
  const mes = hj.slice(0, 7);
  const ab = (ops || []).filter(x => !FAUS.etapasFinais.includes(String(x.Etapa)));
  const ven = ab.filter(x => x.DataProximaAcao && data_(x.DataProximaAcao) < hj);
  const hjA = ab.filter(x => data_(x.DataProximaAcao) === hj);
  const semAcao = ab.filter(x => !data_(x.DataProximaAcao));
  const proximasAcoes = ab
    .filter(x => data_(x.DataProximaAcao) >= hj)
    .sort((a, b) => String(data_(a.DataProximaAcao)).localeCompare(String(data_(b.DataProximaAcao))))
    .slice(0, 5);
  const fec = (ops || []).filter(x => x.Etapa === 'Fechado' && String(x.AtualizadoEm || x.CriadoEm).slice(0, 7) === mes);
  const situacaoFinanceira_ = x => String(x.Situacao || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const ativos = (fin || []).filter(x => situacaoFinanceira_(x) !== 'cancelado');
  const mesFinanceiro_ = x => {
    const base = data_(x.Competencia) || data_(x.DataPagamento) || data_(x.Vencimento) || data_(x.CriadoEm);
    return base ? String(base).slice(0, 7) : '';
  };
  const pagos_ = x => ['pago', 'paga', 'recebido', 'recebida'].includes(situacaoFinanceira_(x));
  const rec = ativos
    .filter(x => x.Tipo === 'Receita' && pagos_(x) && mesFinanceiro_(x) === mes)
    .reduce((t, x) => t + numero_(x.Valor), 0);
  const des = ativos
    .filter(x => x.Tipo === 'Despesa' && pagos_(x) && mesFinanceiro_(x) === mes)
    .reduce((t, x) => t + numero_(x.Valor), 0);
  const cv = ativos.filter(x => x.Tipo === 'Despesa' && x.Vencimento && data_(x.Vencimento) <= hj && !pagos_(x));
  const proximasContasPagar = ativos
    .filter(x => x.Tipo === 'Despesa' && x.Vencimento && data_(x.Vencimento) > hj && !pagos_(x))
    .sort((a, b) => String(data_(a.Vencimento)).localeCompare(String(data_(b.Vencimento))))
    .slice(0, 5);


  return {
    acoesVencidas: ven.length,
    acoesHoje: hjA.length,
    oportunidadesSemAcao: semAcao.length,
    proximasAcoes: proximasAcoes,
    vendasMes: fec.length,
    receitasMes: rec,
    despesasMes: des,
    resultadoMes: rec - des,
    contasVencidas: cv.length,
    valorVencido: cv.reduce((t, x) => t + numero_(x.Valor), 0),
    proximasContasPagar: proximasContasPagar
  };
}



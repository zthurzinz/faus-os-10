function fausDiagnostico() {
  const info = {
    ok: true,
    app: FAUS.nome,
    versao: FAUS.versao,
    dataHora: Utilities.formatDate(new Date(), FAUS.timezone, 'yyyy-MM-dd HH:mm:ss'),
    usuario: '',
    planilha: null,
    abas: [],
    erro: ''
  };
  try {
    info.usuario = Session.getActiveUser().getEmail() || 'sem email visivel';
  } catch (e) {
    info.usuario = 'sem permissao para email';
  }
  try {
    const ss = ss_();
    info.planilha = { id: ss.getId(), nome: ss.getName(), url: ss.getUrl() };
    info.abas = ss.getSheets().map(s => ({
      nome: s.getName(),
      linhas: s.getLastRow(),
      colunas: s.getLastColumn()
    }));
  } catch (e) {
    info.ok = false;
    info.erro = e.message;
  }
  fausLog_('fausDiagnostico', info);
  return serial_(info);
}



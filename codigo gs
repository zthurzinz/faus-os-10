// Escrita restrita aos Afazeres. Leitura, alteração dos mapas e gravação
// compartilham o bloqueio; uma falha ao adquiri-lo nunca autoriza a escrita.
function fausGravarTarefa_(id, preparar, permitirInativa) {
  const trava = LockService.getScriptLock();
  trava.waitLock(10000);
  try {
    const s = ss_().getSheetByName(FAUS.abas.tarefas);
    if (!s) throw new Error('Aba AFAZERES não encontrada.');
    const h = headers_(s);
    const colId = h.indexOf('ID');
    if (colId < 0) throw new Error('Aba AFAZERES sem coluna ID.');
    let linha = 0;
    let row = h.map(() => '');
    if (id) {
      const total = s.getLastRow() - 1;
      const ids = total > 0 ? s.getRange(2, colId + 1, total, 1).getDisplayValues() : [];
      const idx = ids.findIndex(x => String(x[0]) === String(id));
      if (idx < 0) throw new Error('Afazer não encontrado.');
      linha = idx + 2;
      row = s.getRange(linha, 1, 1, h.length).getValues()[0];
    }
    const atual = {};
    h.forEach((campo, i) => { atual[campo] = row[i]; });
    const ativo = String(atual.Ativo || 'Sim').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    if (id && ativo === 'nao' && !permitirInativa) throw new Error('Este afazer foi excluído. Atualize a lista.');
    const alt = preparar(atual);
    Object.keys(alt).forEach(campo => {
      if (!h.includes(campo) && alt[campo] !== '' && alt[campo] != null) {
        throw new Error('Aba AFAZERES sem coluna ' + campo + '. Nenhuma alteração foi gravada.');
      }
    });
    const instante = agora_();
    if (!id) {
      alt.ID = id_();
      if (h.includes('CriadoEm')) alt.CriadoEm = instante;
    }
    if (h.includes('AtualizadoEm')) alt.AtualizadoEm = instante;
    h.forEach((campo, i) => {
      if (Object.prototype.hasOwnProperty.call(alt, campo)) {
        row[i] = typeof alt[campo] === 'string' ? seguro_(alt[campo]) : alt[campo];
      }
    });
    if (id) s.getRange(linha, 1, 1, h.length).setValues([row]);
    else s.appendRow(row);
    const tarefa = {};
    h.forEach((campo, i) => {
      tarefa[campo] = Object.prototype.toString.call(row[i]) === '[object Date]' ? data_(row[i]) : row[i];
    });
    auditar_('APP', id ? 'ATUALIZAR' : 'CRIAR', FAUS.abas.tarefas, tarefa.ID,
      id ? JSON.stringify(alt) : tarefa.Titulo, alt);
    SpreadsheetApp.flush();
    // Retornar a linha confirmada elimina a consulta de toda a lista no cliente.
    const resposta = { ok: true, id: tarefa.ID, tarefa: tarefa };
    return serial_(id ? resposta : Object.assign({}, tarefa, resposta));
  } finally {
    trava.releaseLock();
  }
}


function fausSalvarTarefa(d) {

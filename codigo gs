function fausFinanceiroValor_(linha, displays, mapa, campo) {
  const idx = mapa[campo];
  if (idx === undefined || idx < 0) return '';
  const bruto = linha[idx];
  return bruto === '' || bruto === null || bruto === undefined ? displays[idx] : bruto;
}


function fausFinanceiroNumero_(v) {
  if (typeof v === 'number') return v;
  let s = String(v || '').trim().replace(/[^\d,.\-]/g, '');
  if (!s) return 0;
  const ultimaVirgula = s.lastIndexOf(',');
  const ultimoPonto = s.lastIndexOf('.');
  if (ultimaVirgula >= 0 && ultimoPonto >= 0) {
    s = ultimaVirgula > ultimoPonto ? s.replace(/\./g, '').replace(',', '.') : s.replace(/,/g, '');
  } else if (ultimaVirgula >= 0) {
    s = s.replace(',', '.');
  }
  const n = Number(s);
  return Number.isFinite(n) ? n : 0;
}


function fausFinanceiroData_(v) {
  if (!v) return '';
  if (Object.prototype.toString.call(v) === '[object Date]') {
    return Utilities.formatDate(v, FAUS.timezone, 'yyyy-MM-dd');
  }
  const s = String(v).trim();
  let m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) return [m[1], ('0' + m[2]).slice(-2), ('0' + m[3]).slice(-2)].join('-');
  m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
  if (m) {
    const ano = m[3].length === 2 ? '20' + m[3] : m[3];
    return [ano, ('0' + m[2]).slice(-2), ('0' + m[1]).slice(-2)].join('-');
  }
  return s.slice(0, 10);
}


function fausFinanceiroCompetencia_(linha, disp, mapa) {
  const direta = fausFinanceiroData_(fausFinanceiroValor_(linha, disp, mapa, 'Competencia'));
  if (/^\d{4}-\d{2}-\d{2}$/.test(direta)) return direta;

  const mes = Math.floor(fausFinanceiroNumero_(fausFinanceiroValor_(linha, disp, mapa, 'Mes') || direta));
  const ano = Math.floor(fausFinanceiroNumero_(fausFinanceiroValor_(linha, disp, mapa, 'Ano')));
  if (ano >= 1900 && mes >= 1 && mes <= 12) {
    return ano + '-' + ('0' + mes).slice(-2) + '-01';
  }

  if (/^\d{4}-\d{2}$/.test(direta)) return direta + '-01';
  return direta;
}


function fausFinanceiroTipo_(v, abaTipo, valor) {
  const n = String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  if (n.indexOf('receita') >= 0 || n.indexOf('entrada') >= 0 || n.indexOf('receb') >= 0) return 'Receita';
  if (n.indexOf('despesa') >= 0 || n.indexOf('saida') >= 0 || n.indexOf('pagar') >= 0 || n.indexOf('custo') >= 0) return 'Despesa';
  if (abaTipo === 'contas') return 'Despesa';
  return Number(valor) < 0 ? 'Despesa' : 'Receita';
}


function fausFinanceiroSituacao_(v, tipo, dataPagamento) {
  const n = String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  if (n.indexOf('cancel') >= 0) return 'Cancelado';
  if (dataPagamento || n.indexOf('pago') >= 0 || n.indexOf('quit') >= 0 || n.indexOf('baix') >= 0 || n === 'sim' || n === 'true') {
    return tipo === 'Receita' ? 'Recebido' : 'Pago';
  }
  if (n.indexOf('receb') >= 0) return 'Recebido';
  if (n.indexOf('venc') >= 0) return 'Vencido';
  return n ? v : 'Pendente';
}


function fausFinanceiroObjetosAba_(tipo, limiteLinhas) {
  try {
    const s = fausFinanceiroAba_(tipo, false);
    if (!s || s.getLastRow() < 2) return [];
    const h = headers_(s);
    if (!h.length) return [];
    const mapa = fausFinanceiroMapaHeaders_(h);
    if (mapa.Valor === undefined) {
      fausFinanceiroStatusErro_('Aba financeira sem coluna de valor reconhecida: ' + s.getName() + '.', { aba: s.getName() });
      return [];
    }
    const totalDados = s.getLastRow() - 1;
    const qtd = limiteLinhas ? Math.min(totalDados, Math.max(1, Number(limiteLinhas))) : totalDados;
    const linhaInicial = 2 + (totalDados - qtd);
    const linhas = s.getRange(linhaInicial, 1, qtd, h.length).getValues();
    const displays = s.getRange(linhaInicial, 1, qtd, h.length).getDisplayValues();
    return linhas.map((linha, i) => {
      const disp = displays[i];
      const valor = fausFinanceiroNumero_(fausFinanceiroValor_(linha, disp, mapa, 'Valor'));
      const competencia = fausFinanceiroCompetencia_(linha, disp, mapa);
      const vencimento = fausFinanceiroData_(fausFinanceiroValor_(linha, disp, mapa, 'Vencimento')) || competencia;
      const dataPagamento = fausFinanceiroData_(fausFinanceiroValor_(linha, disp, mapa, 'DataPagamento'));
      const tipoMov = fausFinanceiroTipo_(fausFinanceiroValor_(linha, disp, mapa, 'Tipo'), tipo, valor);
      const idReal = fausFinanceiroValor_(linha, disp, mapa, 'ID');
      const registro = {
        _linha: linhaInicial + i,
        _financeiroAba: tipo,
        ID: idReal || ('FIN-' + s.getSheetId() + '-' + (i + 2)),
        Tipo: tipoMov,
        Descricao: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'Descricao')),
        Categoria: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'Categoria')),
        CentroCusto: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'CentroCusto')),
        ClienteID: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'ClienteID')),
        OportunidadeID: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'OportunidadeID')),
        Maquina: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'Maquina')),
        Valor: Math.abs(valor),
        Competencia: competencia,
        Vencimento: vencimento,
        Situacao: fausFinanceiroSituacao_(fausFinanceiroValor_(linha, disp, mapa, 'Situacao'), tipoMov, dataPagamento),
        DataPagamento: dataPagamento,
        FormaPagamento: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'FormaPagamento')),
        DocumentoUrl: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'DocumentoUrl')),
        Observacoes: seguro_(fausFinanceiroValor_(linha, disp, mapa, 'Observacoes')),
        Ativo: fausFinanceiroValor_(linha, disp, mapa, 'Ativo') || 'Sim',
        CriadoEm: fausFinanceiroData_(fausFinanceiroValor_(linha, disp, mapa, 'CriadoEm')),
        AtualizadoEm: fausFinanceiroData_(fausFinanceiroValor_(linha, disp, mapa, 'AtualizadoEm'))
      };
      return registro;
    }).filter(o => {
      const ativo = String(o.Ativo || 'Sim').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      return ativo !== 'nao' && (o.Descricao || o.Valor || o.Vencimento);
    });
  } catch (e) {
    fausLog_('financeiro leitura falhou', { aba: tipo, erro: e.message });
    return [];
  }
}


function fausFinanceiroObjetos_(limiteLancamentos) {

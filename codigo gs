function fausObsidianArquivo_(pasta, nome, criarSeAusente) {
  if (!pasta) return null;
  try {
    const it = pasta.getFilesByName(nome);
    if (it.hasNext()) return it.next();
    if (criarSeAusente) {
      const modeloPadrao = '# ' + nome.replace(/\.md$/i, '') + '\n\n## Comercial\n\n## Financeiro\n\n## Operação\n\n## Gestão\n';
      return pasta.createFile(nome, modeloPadrao, 'text/markdown');
    }
  } catch (e) {}
  return null;
}


function fausObsidianLerArquivo_(pasta, nome) {
  try {
    const arq = fausObsidianArquivo_(pasta, nome, nome === FAUS_OBSIDIAN.arquivos.afazeres);
    return arq ? arq.getBlob().getDataAsString('UTF-8') : '';
  } catch (e) {
    return '';
  }
}


function fausCategoriaSemana_(titulo) {
  const n = String(titulo || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  if (n.indexOf('comercial') >= 0) return 'Comercial';
  if (n.indexOf('gestao') >= 0) return 'Gestão';
  if (n.indexOf('financeiro') >= 0) return 'Financeiro';
  if (n.indexOf('maquina') >= 0 || n.indexOf('operacao') >= 0) return 'Operação';
  return '';
}


function fausObsidianLimparLinha_(s) {
  return String(s || '')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[`_#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}


function fausObsidianParseAfazeres_(md) {
  const linhas = String(md || '').split(/\r?\n/);
  const itens = [];
  const metas = [];
  const mapa = {};
  let categoria = 'Geral';
  let emMetas = false;


  linhas.forEach((l, i) => {
    const titulo = l.match(/^\s{0,3}#{1,6}\s+(.+)$/);
    const check = l.match(/^\s*[-*]\s+\[([ xX])\]\s+(.+)$/);
    const meta = l.match(/^\s*[-*]\s+(?!\[[ xX]\]\s+)(.+)$/);


    if (titulo) {
      const limpo = fausObsidianLimparLinha_(titulo[1]);
      emMetas = String(limpo || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().indexOf('meta') >= 0;
      const cat = fausCategoriaSemana_(limpo);
      if (cat) categoria = cat;
      else if (categoria === 'Geral') categoria = limpo || 'Geral';
      return;
    }
    if (emMetas && meta) {
      const textoMeta = fausObsidianLimparLinha_(meta[1]);
      if (textoMeta) metas.push({ texto: textoMeta });
      return;
    }
    if (!check) return;
    const cat = fausCategoriaSemana_(categoria) || categoria || 'Geral';
    const afazer = {
      id: 'L' + (i + 1),
      linha: i + 1,
      categoria: cat,
      texto: fausObsidianLimparLinha_(check[2]),
      concluido: check[1].toLowerCase() === 'x'
    };
    itens.push(afazer);
    if (!mapa[cat]) mapa[cat] = { nome: cat, itens: [], total: 0, concluidas: 0, pendentes: 0 };
    mapa[cat].itens.push(afazer);
    mapa[cat].total++;
    if (afazer.concluido) mapa[cat].concluidas++;
    else mapa[cat].pendentes++;
  });


  const total = itens.length;
  const concluidas = itens.filter(x => x.concluido).length;


  return {
    total: total,
    concluidas: concluidas,
    pendentes: total - concluidas,
    metas: metas.slice(0, 3),
    itens: itens,
    categorias: Object.keys(mapa).map(k => mapa[k])
  };
}


function fausObsidianParseDocumento_(md) {
  const secoes = [];
  const linhas = String(md || '').split(/\r?\n/);
  let atual = null;


  linhas.forEach(l => {
    const titulo = l.match(/^\s{0,3}(#{1,4})\s+(.+)$/);
    if (titulo) {
      atual = { titulo: fausObsidianLimparLinha_(titulo[2]), texto: [] };
      secoes.push(atual);
      return;
    }
    if (!atual) {
      atual = { titulo: 'Geral', texto: [] };
      secoes.push(atual);
    }
    const txt = fausObsidianLimparLinha_(l);
    if (txt) atual.texto.push(txt);
  });


  return secoes.slice(0, 8).map(s => ({
    titulo: s.titulo,
    texto: s.texto.join(' ').slice(0, 300)
  }));
}


function fausObsidianMvp() {
  try {
    const pasta = fausObterPastaDirecao_();
    if (!pasta) {
      return { ok: false, afazeres: { total: 0, concluidas: 0, pendentes: 0, itens: [] }, visao: [], metas: [], projetos: [], planejamento: [] };
    }
    const lidos = {};
    Object.keys(FAUS_OBSIDIAN.arquivos).forEach(k => {
      lidos[k] = fausObsidianLerArquivo_(pasta, FAUS_OBSIDIAN.arquivos[k]);
    });
    return {
      ok: true,
      afazeres: fausObsidianParseAfazeres_(lidos.afazeres),
      visao: fausObsidianParseDocumento_(lidos.visao),
      metas: fausObsidianParseDocumento_(lidos.metas),
      projetos: fausObsidianParseDocumento_(lidos.projetos),
      planejamento: fausObsidianParseDocumento_(lidos.planejamento)
    };
  } catch (e) {
    return { ok: false, erro: e.message, afazeres: { total: 0, concluidas: 0, pendentes: 0, itens: [] }, visao: [], metas: [], projetos: [], planejamento: [] };
  }
}


function fausSalvarSemana(dados) {
  return lock_(() => {
    dados = dados || {};
    const pasta = fausObterPastaDirecao_();
    if (!pasta) return { total: 0, concluidas: 0, pendentes: 0, itens: [] };
    const arq = fausObsidianArquivo_(pasta, FAUS_OBSIDIAN.arquivos.afazeres, true);
    if (!arq) return { total: 0, concluidas: 0, pendentes: 0, itens: [] };


    const linhas = ['# Afazeres da semana'];
    const metas = (dados.metas || [])
      .map(m => fausObsidianLimparLinha_(m.texto || m))
      .filter(Boolean)
      .slice(0, 3);

    if (metas.length) {
      linhas.push('', '## Metas da semana');
      metas.forEach(m => linhas.push('- ' + m));
    }

    const categorias = ['Comercial', 'Financeiro', 'Operação', 'Gestão'];


    categorias.forEach(cat => {
      linhas.push('', '## ' + cat);
      const catSemAcento = cat.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const tarefas = ((dados.tarefas && (dados.tarefas[cat] || dados.tarefas[catSemAcento])) || []).filter(Boolean);
      tarefas.forEach(t => {
        const texto = fausObsidianLimparLinha_(t.texto || t);
        const feito = !!(t.concluido || t.feito);
        if (texto) linhas.push('- [' + (feito ? 'x' : ' ') + '] ' + texto);
      });
    });


    const md = linhas.join('\n') + '\n';
    arq.setContent(md);
    return fausObsidianParseAfazeres_(md);
  });
}


function fausAlternarAfazerSemana(id) {
  return lock_(() => {
    const pasta = fausObterPastaDirecao_();
    if (!pasta) throw new Error('Pasta de direção não encontrada.');


    const arq = fausObsidianArquivo_(
      pasta,
      FAUS_OBSIDIAN.arquivos.afazeres,
      true
    );


    if (!arq) throw new Error('Arquivo de afazeres não encontrado.');


    const md = arq.getBlob().getDataAsString('UTF-8');
    const linhas = String(md || '').split(/\r?\n/);
    const n = Number(String(id || '').replace(/^L/i, ''));


    if (!Number.isFinite(n) || n < 1 || n > linhas.length) {
      throw new Error('Afazer não encontrado.');
    }


    const idx = n - 1;
    const linha = linhas[idx];


    if (/^\s*[-*]\s+\[[ xX]\]\s+/.test(linha)) {
      linhas[idx] = linha.replace(/\[[ xX]\]/, m => {
        return m.toLowerCase() === '[x]' ? '[ ]' : '[x]';
      });
    } else {
      throw new Error('Linha do afazer inválida.');
    }


    const novoMd = linhas.join('\n');
    arq.setContent(novoMd);


    return fausObsidianParseAfazeres_(novoMd);
  });
}



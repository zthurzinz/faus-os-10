function fausFinanceiroMapaHeaders_(headers) {
  const chaves = headers.map(fausFinanceiroChave_);
  const aliases = fausFinanceiroAliases_();
  const mapa = {};
  Object.keys(aliases).forEach(campo => {
    const opcoes = [campo].concat(aliases[campo]).map(fausFinanceiroChave_);
    const idx = chaves.findIndex(k => opcoes.includes(k));
    if (idx >= 0) mapa[campo] = idx;
  });
  return mapa;

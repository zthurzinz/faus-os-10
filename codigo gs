function fausFinanceiroAtualizar_(id, alt) {
  return lock_(() => {
    const tipos = ['lancamentos', 'contas'];
    for (let i = 0; i < tipos.length; i++) {
      const tipo = tipos[i];
      const s = fausFinanceiroAba_(tipo, false);
      if (!s || s.getLastRow() < 2) continue;
      let h = headers_(s);
      let mapa = fausFinanceiroMapaHeaders_(h);
      let lin = -1;
      const sint = String(id || '').match(/^FIN-(\d+)-(\d+)$/);
      if (sint && Number(sint[1]) === Number(s.getSheetId())) {
        lin = Number(sint[2]);
      } else if (mapa.ID !== undefined) {
        const ids = s.getRange(2, mapa.ID + 1, s.getLastRow() - 1, 1).getDisplayValues();
        ids.some((x, idx) => {
          if (String(x[0]) === String(id)) {
            lin = idx + 2;
            return true;
          }
          return false;
        });
      }
      if (lin < 2 || lin > s.getLastRow()) continue;
      Object.keys(alt || {}).forEach(campo => {
        const col = fausFinanceiroGarantirHeader_(s, campo);
        s.getRange(lin, col).setValue(typeof alt[campo] === 'string' ? seguro_(alt[campo]) : alt[campo]);
      });
      const colAtualizado = fausFinanceiroGarantirHeader_(s, 'AtualizadoEm');
      s.getRange(lin, colAtualizado).setValue(agora_());
      auditar_('APP', 'ATUALIZAR', FAUS.abas.financeiro, id, JSON.stringify(alt), alt);
      return { ok: true, id: id };
    }
    throw new Error('Registro financeiro não encontrado.');
  });
}



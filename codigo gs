function fausCrmCanal_(v) {
  const texto = fausCrmTexto_(v) || 'Não identificado';
  const achado = FAUS_CRM_CANAIS.find(c => fausCrmNormalizar_(c) === fausCrmNormalizar_(texto));
  return achado || 'Outros';
}

function fausCrmStatus_(v) {
  const status = fausCrmTexto_(v) || 'nao_solicitado';
  if (!FAUS_CRM_STATUS.includes(status)) throw new Error('Status de orçamento inválido.');
  return status;
}

function fausCrmEtapaPorStatus_(status) {
  return {
    nao_solicitado: 'Novo lead',
    solicitado: 'Orçamento necessário',
    enviado: 'Proposta enviada',
    aprovado: 'Fechado',
    perdido: 'Perdido'
  }[status] || 'Novo lead';
}

function fausCrmValidarEstrutura_(abas) {
  const ss = ss_();
  const out = {};
  (abas || ['CLIENTES', 'OPORTUNIDADES', 'INTERACOES']).forEach(nome => {
    const s = ss.getSheetByName(nome);
    if (!s) throw new Error('Estrutura CRM incompatível: aba ausente ' + nome + '.');
    const h = headers_(s).filter(String);
    const obrigatorios = (ESQUEMAS[nome] || []).filter(c => {
      if (nome === 'CLIENTES') return ['ID', 'Nome', 'Empresa', 'Telefone', 'Status', 'Ativo', 'CriadoEm', 'AtualizadoEm', 'CanalOrigem'].includes(c);
      if (nome === 'OPORTUNIDADES') return ['ID', 'ClienteID', 'Titulo', 'Servico', 'Canal', 'Etapa', 'ProximaAcao', 'DataProximaAcao', 'MotivoPerda', 'Ativo', 'CriadoEm', 'AtualizadoEm', 'StatusOrcamento', 'ValorOrcamento', 'ValorVendido', 'DataSolicitacaoOrcamento', 'DataEnvioOrcamento', 'DataAprovacaoOrcamento', 'DataPerdaOrcamento'].includes(c);
      if (nome === 'INTERACOES') return ['ID', 'OportunidadeID', 'ClienteID', 'Tipo', 'Descricao', 'DataInteracao', 'ProximaAcao', 'DataProximaAcao', 'Responsavel', 'CriadoEm'].includes(c);
      return true;
    });
    const faltantes = obrigatorios.filter(c => !h.includes(c));
    if (faltantes.length) {
      throw new Error('Estrutura CRM incompatível em ' + nome + ': faltam ' + faltantes.join(', ') + '.');
    }
    out[nome] = { sheet: s, headers: h };
  });
  return out;
}

function fausCrmObjetosPlanilha_(ctx, nome) {
  const info = ctx[nome];
  const s = info.sheet;
  const h = info.headers;
  if (s.getLastRow() < 2) return [];
  const valores = s.getRange(2, 1, s.getLastRow() - 1, h.length).getValues();
  return valores.map((linha, i) => {
    const obj = { _linha: i + 2 };
    h.forEach((campo, j) => obj[campo] = fausCrmValorSerial_(campo, linha[j]));
    return obj;
  }).filter(obj => {
    if (!Object.prototype.hasOwnProperty.call(obj, 'Ativo')) return true;
    const ativo = fausCrmNormalizar_(obj.Ativo);
    return ativo !== 'nao';
  });
}

function fausCrmAppend_(ctx, nome, dados, origem) {
  const info = ctx[nome];
  const h = info.headers;
  const r = Object.assign({}, dados);
  const a = agora_();
  if (h.includes('ID') && !r.ID) r.ID = id_();
  if (h.includes('Ativo') && !r.Ativo) r.Ativo = 'Sim';
  if (h.includes('CriadoEm') && !r.CriadoEm) r.CriadoEm = a;
  if (h.includes('AtualizadoEm')) r.AtualizadoEm = a;
  info.sheet.appendRow(h.map(k => typeof r[k] === 'string' ? seguro_(r[k]) : (r[k] === undefined ? '' : r[k])));
  try {
    if (ss_().getSheetByName(FAUS.abas.historico)) {
      auditar_(origem || 'APP', 'CRIAR', nome, r.ID || '', r.Titulo || r.Nome || r.Descricao || '', r);
    }
  } catch (e) {}
  return serial_(r);
}

function fausCrmUpdate_(ctx, nome, id, alt) {
  const info = ctx[nome];
  const h = info.headers;
  const c = h.indexOf('ID');
  if (c < 0) throw new Error('Aba sem coluna ID: ' + nome + '.');
  const ids = info.sheet.getRange(2, c + 1, Math.max(info.sheet.getLastRow() - 1, 1), 1).getDisplayValues();
  let lin = -1;
  ids.some((x, i) => {
    if (String(x[0]) === String(id)) {
      lin = i + 2;
      return true;
    }
    return false;
  });
  if (lin < 0) throw new Error('Registro não encontrado em ' + nome + '.');
  const row = info.sheet.getRange(lin, 1, 1, h.length).getValues()[0];
  h.forEach((k, i) => {
    if (Object.prototype.hasOwnProperty.call(alt, k)) row[i] = typeof alt[k] === 'string' ? seguro_(alt[k]) : alt[k];
    if (k === 'AtualizadoEm') row[i] = agora_();
  });
  info.sheet.getRange(lin, 1, 1, h.length).setValues([row]);
  try {
    if (ss_().getSheetByName(FAUS.abas.historico)) {
      auditar_('APP', 'ATUALIZAR', nome, id, JSON.stringify(serial_(alt)), alt);
    }
  } catch (e) {}
  return { ok: true, id: id };
}

function fausCarregarCRM() {
  const ss = ss_();
  const avisos = [];
  const camposClientes = [];
  const camposOportunidades = [];
  try {
    const ctx = fausCrmValidarEstrutura_(['CLIENTES', 'OPORTUNIDADES', 'INTERACOES']);
    camposClientes.push.apply(camposClientes, ctx.CLIENTES.headers);
    camposOportunidades.push.apply(camposOportunidades, ctx.OPORTUNIDADES.headers);
  } catch (e) {
    avisos.push(e.message);
  }

  const lerAba = (nome, limite) => {
    const s = ss.getSheetByName(nome);
    if (!s) {
      avisos.push('Aba não encontrada: ' + nome);
      return [];
    }
    const h = headers_(s);
    if (!h.length || s.getLastRow() < 2) return [];
    const total = s.getLastRow() - 1;
    const qtd = Math.min(total, Math.max(1, Number(limite || total)));
    const inicio = 2 + (total - qtd);
    const valores = s.getRange(inicio, 1, qtd, h.length).getValues();
    return valores.map((linha, i) => {
      const obj = { _linha: inicio + i };
      h.forEach((campo, j) => {
        obj[campo] = fausCrmValorSerial_(campo, linha[j]);
      });
      return obj;
    }).filter(obj => {
      if (!Object.prototype.hasOwnProperty.call(obj, 'Ativo')) return true;
      const ativo = String(obj.Ativo).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      return ativo !== 'nao';
    });
  };

  const clientes = lerAba('CLIENTES', 1000);
  const oportunidades = lerAba('OPORTUNIDADES', 1500);
  const nomes = {};
  clientes.forEach(c => {
    nomes[c.ID] = c.Empresa || c.Nome || c.ID;
  });
  oportunidades.forEach(o => {
    o.ClienteNome = nomes[o.ClienteID] || o.ClienteNome || 'Sem cliente';
  });

  return serial_({
    ok: true,
    readOnly: false,
    avisos: avisos,
    meta: {
      hoje: hoje_(),
      canais: FAUS_CRM_CANAIS,
      etapas: FAUS.etapas,
      camposClientes: camposClientes.length ? camposClientes : (clientes.length ? Object.keys(clientes[0]).filter(k => k !== '_linha') : []),
      camposOportunidades: camposOportunidades.length ? camposOportunidades : (oportunidades.length ? Object.keys(oportunidades[0]).filter(k => k !== '_linha') : [])
    },
    clientes: clientes,
    oportunidades: oportunidades
  });
}


function fausSalvarCRMComercial(d) {
  d = d || {};
  const nome = fausCrmTexto_(d.Nome);
  const empresa = fausCrmTexto_(d.Empresa);
  const telefone = fausCrmTexto_(d.Telefone);
  const canal = fausCrmCanal_(d.CanalOrigem || d.Canal);
  const servico = fausCrmTexto_(d.Servico || d.Titulo);
  const titulo = fausCrmTexto_(d.Titulo || servico || 'Atendimento comercial');
  if (!nome) throw new Error('Informe o nome do cliente.');
  if (!canal) throw new Error('Informe o canal de origem.');
  return lock_(() => {
    const ctx = fausCrmValidarEstrutura_(['CLIENTES', 'OPORTUNIDADES', 'INTERACOES']);
    const clientes = fausCrmObjetosPlanilha_(ctx, 'CLIENTES');
    const telefoneKey = fausCrmTelefoneKey_(telefone);
    const nomeKey = fausCrmNormalizar_(nome);
    const empresaKey = fausCrmNormalizar_(empresa);
    let candidatos = [];
    if (telefoneKey && telefoneKey.length >= 8) {
      candidatos = clientes.filter(c => fausCrmTelefoneKey_(c.Telefone) === telefoneKey);
    } else if (nomeKey) {
      candidatos = clientes.filter(c => fausCrmNormalizar_(c.Nome) === nomeKey && (!empresaKey || fausCrmNormalizar_(c.Empresa) === empresaKey));
    }
    const ids = Array.from(new Set(candidatos.map(c => String(c.ID || '')))).filter(Boolean);
    if (ids.length > 1) throw new Error('Cliente ambíguo: há mais de um cadastro parecido. Revise CLIENTES antes de gravar.');
    let cliente = candidatos[0] || null;
    if (!cliente) {
      cliente = fausCrmAppend_(ctx, 'CLIENTES', {
        Nome: nome,
        Empresa: empresa,
        Telefone: telefone,
        Tipo: 'Comercial',
        Status: 'Ativo',
        CanalOrigem: canal,
        Observacoes: fausCrmTexto_(d.Observacoes)
      }, 'CRM');
    } else {
      const altCliente = {};
      if (empresa && !fausCrmTexto_(cliente.Empresa)) altCliente.Empresa = empresa;
      if (telefone && !fausCrmTexto_(cliente.Telefone)) altCliente.Telefone = telefone;
      if (canal && (!fausCrmTexto_(cliente.CanalOrigem) || fausCrmTexto_(cliente.CanalOrigem) === 'Não identificado')) altCliente.CanalOrigem = canal;
      if (Object.keys(altCliente).length) {
        fausCrmUpdate_(ctx, 'CLIENTES', cliente.ID, altCliente);
        cliente = Object.assign({}, cliente, altCliente);
      }
    }
    const oportunidades = fausCrmObjetosPlanilha_(ctx, 'OPORTUNIDADES');
    const servicoKey = fausCrmNormalizar_(servico || titulo);
    const duplicada = oportunidades.find(o => {
      if (String(o.ClienteID || '') !== String(cliente.ID || '')) return false;
      if (fausCrmNormalizar_(o.Ativo) === 'nao') return false;
      if (['aprovado', 'perdido'].includes(String(o.StatusOrcamento || ''))) return false;
      const alvo = fausCrmNormalizar_(o.Servico || o.Titulo);
      return servicoKey && alvo && alvo === servicoKey;
    });
    if (duplicada) {
      return serial_({ ok: true, reutilizada: true, cliente: cliente, oportunidade: duplicada });
    }
    const status = fausCrmStatus_(d.StatusOrcamento || 'nao_solicitado');
    const oportunidade = fausCrmAppend_(ctx, 'OPORTUNIDADES', {
      ClienteID: cliente.ID,
      Titulo: titulo,
      Servico: servico,
      Canal: canal,
      Etapa: fausCrmEtapaPorStatus_(status),
      StatusOrcamento: status,
      ValorOrcamento: fausCrmTexto_(d.ValorOrcamento) ? numero_(d.ValorOrcamento) : '',
      ValorVendido: fausCrmTexto_(d.ValorVendido) ? numero_(d.ValorVendido) : '',
      Responsavel: fausCrmTexto_(d.Responsavel) || 'Arthur',
      ProximaAcao: fausCrmTexto_(d.ProximaAcao),
      DataProximaAcao: fausCrmTexto_(d.DataProximaAcao),
      MotivoPerda: fausCrmTexto_(d.MotivoPerda)
    }, 'CRM');
    return serial_({ ok: true, reutilizada: false, cliente: cliente, oportunidade: oportunidade });
  });
}


function fausAtualizarOrcamentoCRM(d) {
  d = d || {};
  const id = fausCrmTexto_(d.OportunidadeID || d.ID);
  if (!id) throw new Error('Informe a oportunidade.');
  const status = fausCrmStatus_(d.StatusOrcamento);
  return lock_(() => {
    const ctx = fausCrmValidarEstrutura_(['OPORTUNIDADES', 'INTERACOES']);
    const oportunidades = fausCrmObjetosPlanilha_(ctx, 'OPORTUNIDADES');
    const atual = oportunidades.find(o => String(o.ID) === String(id));
    if (!atual) throw new Error('Oportunidade não encontrada.');
    const alt = { StatusOrcamento: status, Etapa: fausCrmEtapaPorStatus_(status) };
    if (fausCrmTexto_(d.ValorOrcamento)) alt.ValorOrcamento = numero_(d.ValorOrcamento);
    if (fausCrmTexto_(d.ValorVendido)) alt.ValorVendido = numero_(d.ValorVendido);
    if (fausCrmTexto_(d.MotivoPerda)) alt.MotivoPerda = fausCrmTexto_(d.MotivoPerda);
    if (status === 'solicitado' && !atual.DataSolicitacaoOrcamento) alt.DataSolicitacaoOrcamento = hoje_();
    if (status === 'enviado') {
      if (!atual.DataEnvioOrcamento) alt.DataEnvioOrcamento = fausCrmAgoraIso_();
      if (!atual.DataProximaAcao) {
        alt.ProximaAcao = 'Follow-up automático 3h após envio';
        alt.DataProximaAcao = fausCrmAdicionarHorasIso_(3);
      }
    }
    if (status === 'aprovado' && !atual.DataAprovacaoOrcamento) alt.DataAprovacaoOrcamento = hoje_();
    if (status === 'perdido' && !atual.DataPerdaOrcamento) alt.DataPerdaOrcamento = hoje_();
    fausCrmUpdate_(ctx, 'OPORTUNIDADES', id, alt);
    fausCrmAppend_(ctx, 'INTERACOES', {
      OportunidadeID: id,
      ClienteID: atual.ClienteID || '',
      Tipo: 'Atualização de orçamento',
      Descricao: 'Status alterado para ' + status,
      DataInteracao: fausCrmAgoraIso_(),
      ProximaAcao: alt.ProximaAcao || atual.ProximaAcao || '',
      DataProximaAcao: alt.DataProximaAcao || atual.DataProximaAcao || '',
      Responsavel: fausCrmTexto_(d.Responsavel) || atual.Responsavel || 'Arthur'
    }, 'CRM');
    return serial_({ ok: true, id: id, alteracoes: alt });
  });
}


function fausAtualizarAcompanhamentoCRM(d) {
  d = d || {};
  const id = fausCrmTexto_(d.OportunidadeID || d.ID);
  if (!id) throw new Error('Informe a oportunidade.');
  const acao = fausCrmTexto_(d.ProximaAcao);
  const data = fausCrmTexto_(d.DataProximaAcao);
  if (!acao || !data) throw new Error('Informe a próxima ação e a data do acompanhamento.');
  return lock_(() => {
    const ctx = fausCrmValidarEstrutura_(['OPORTUNIDADES', 'INTERACOES']);
    const oportunidades = fausCrmObjetosPlanilha_(ctx, 'OPORTUNIDADES');
    const atual = oportunidades.find(o => String(o.ID) === String(id));
    if (!atual) throw new Error('Oportunidade não encontrada.');
    const alt = { ProximaAcao: acao, DataProximaAcao: data };
    fausCrmUpdate_(ctx, 'OPORTUNIDADES', id, alt);
    fausCrmAppend_(ctx, 'INTERACOES', {
      OportunidadeID: id,
      ClienteID: atual.ClienteID || '',
      Tipo: 'Acompanhamento agendado',
      Descricao: acao,
      DataInteracao: fausCrmAgoraIso_(),
      ProximaAcao: acao,
      DataProximaAcao: data,
      Responsavel: fausCrmTexto_(d.Responsavel) || atual.Responsavel || 'Arthur'
    }, 'CRM');
    return serial_({ ok: true, id: id, alteracoes: alt });
  });
}


function fausConcluirAcompanhamentoCRM(d) {
  d = d || {};
  const id = fausCrmTexto_(d.OportunidadeID || d.ID);
  if (!id) throw new Error('Informe a oportunidade.');
  return lock_(() => {
    const ctx = fausCrmValidarEstrutura_(['OPORTUNIDADES', 'INTERACOES']);
    const oportunidades = fausCrmObjetosPlanilha_(ctx, 'OPORTUNIDADES');
    const atual = oportunidades.find(o => String(o.ID) === String(id));
    if (!atual) throw new Error('Oportunidade não encontrada.');
    const novaAcao = fausCrmTexto_(d.ProximaAcao);
    const novaData = fausCrmTexto_(d.DataProximaAcao);
    const alt = novaAcao && novaData
      ? { ProximaAcao: novaAcao, DataProximaAcao: novaData }
      : { ProximaAcao: '', DataProximaAcao: '' };
    fausCrmUpdate_(ctx, 'OPORTUNIDADES', id, alt);
    fausCrmAppend_(ctx, 'INTERACOES', {
      OportunidadeID: id,
      ClienteID: atual.ClienteID || '',
      Tipo: 'Follow-up realizado',
      Descricao: fausCrmTexto_(d.Descricao) || 'Acompanhamento comercial realizado.',
      DataInteracao: fausCrmAgoraIso_(),
      ProximaAcao: novaAcao,
      DataProximaAcao: novaData,
      Responsavel: fausCrmTexto_(d.Responsavel) || atual.Responsavel || 'Arthur'
    }, 'CRM');
    return serial_({ ok: true, id: id, alteracoes: alt });
  });
}



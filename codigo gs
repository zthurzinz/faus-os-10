function fausPrepararPlanilha() {
  const ss = ss_();
  Object.keys(ESQUEMAS).forEach(n => {
    let s = ss.getSheetByName(n);
    if (!s) s = ss.insertSheet(n);
    const esp = ESQUEMAS[n];
    if (s.getLastRow() === 0) {
      s.getRange(1, 1, 1, esp.length).setValues([esp]);
    } else {
      const at = headers_(s).filter(String);
      const falt = esp.filter(c => !at.includes(c));
      if (falt.length) s.getRange(1, at.length + 1, 1, falt.length).setValues([falt]);
    }
    s.setFrozenRows(1);
    s.getRange(1, 1, 1, s.getLastColumn()).setBackground('#0d2019').setFontColor('#FFFFFF').setFontWeight('bold');
  });
  return { ok: true };
}



function fausJson_(v, padrao) {
  if (!v) return padrao;
  if (typeof v === 'object') return v;
  try {
    return JSON.parse(String(v));
  } catch (e) {
    return padrao;
  }
}


function fausFinanceiroChave_(v) {
  return String(v || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');
}

function fausFinanceiroResetStatus_() {
  FAUS_FINANCEIRO_STATUS.erros = [];
